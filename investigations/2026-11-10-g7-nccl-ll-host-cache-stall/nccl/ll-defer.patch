+  // Publish a deferred LL step size after every thread finished its stores, so the
+  // proxy can hand the buffer to the network without reading the LL lines back.
+  inline __device__ void postSendDeferred(int nbytes) {
+    if (nbytes < NCCL_LL_DEFER_SIZE_MIN) return;
+    barrier();
+    if (deferredSize) {
+      __threadfence_system();
+      sendConnFifo[deferredSlot].size = deferredSize;
+      deferredSize = 0;
+    }
+  }
 
