# Copy to env.sh and fill in. Every numbered script sources env.sh.
export AWS_REGION=sa-east-1
export STACK_NAME=P5eCampaign
export AVAILABILITY_ZONE=sa-east-1c
export INSTANCE_TYPE=p5e.48xlarge
# Deep Learning Base OSS Nvidia Driver GPU AMI (Ubuntu 24.04), pinned. Look up the latest with:
#   aws ec2 describe-images --region $AWS_REGION --owners amazon \
#     --filters "Name=name,Values=Deep Learning Base OSS Nvidia Driver GPU AMI (Ubuntu 24.04)*" \
#     --query 'sort_by(Images,&CreationDate)[-1].[ImageId,Name]' --output text
export AMI_ID=
# Capacity Block reservation id and its start; launch attempts are made a few minutes after the start.
export CAPACITY_RESERVATION_ID=
export LAUNCH_AT_UTC=
# The FSx for Lustre file system is deleted at this time at the latest (shortly after the block ends).
export CLEANUP_AT_UTC=
