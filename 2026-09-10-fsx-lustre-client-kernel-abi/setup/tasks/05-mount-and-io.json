{
  "name": "Mount the file system and prove read and write traffic",
  "tasks": [
    {
      "id": "01-mount",
      "name": "Mount the file system",
      "commands": [
        "DNS=${FSX_DNS_NAME:?FSX_DNS_NAME must be set}",
        "MOUNTNAME=${FSX_MOUNT_NAME:?FSX_MOUNT_NAME must be set}",
        "POINT=${MOUNT_POINT:-/mnt/fsx}",
        "mkdir -p \"${POINT}\"",
        "mount -t lustre -o noatime,flock \"${DNS}@tcp:/${MOUNTNAME}\" \"${POINT}\"",
        "mount | grep lustre",
        "df -h \"${POINT}\""
      ]
    },
    {
      "id": "02-filesystem-facts",
      "name": "Report the file system layout and the server version",
      "commands": [
        "POINT=${MOUNT_POINT:-/mnt/fsx}",
        "lfs df -h \"${POINT}\"",
        "lfs getstripe -d \"${POINT}\" || true",
        "lctl get_param -n version | head -5 || true"
      ]
    },
    {
      "id": "03-write-read-verify",
      "name": "Write a file, read it back and compare checksums",
      "commands": [
        "POINT=${MOUNT_POINT:-/mnt/fsx}",
        "DIR=\"${POINT}/kernel-abi-check-$(hostname)-$(date -u +%Y%m%dT%H%M%SZ)\"",
        "SIZE_MB=${IO_SIZE_MB:-256}",
        "mkdir -p \"${DIR}\"",
        "dd if=/dev/urandom of=/tmp/abi-check.bin bs=1M count=${SIZE_MB} status=none",
        "SRC=$(md5sum /tmp/abi-check.bin | awk '{print $1}')",
        "dd if=/tmp/abi-check.bin of=\"${DIR}/abi-check.bin\" bs=1M status=progress conv=fsync",
        "echo 3 > /proc/sys/vm/drop_caches",
        "DST=$(md5sum \"${DIR}/abi-check.bin\" | awk '{print $1}')",
        "echo \"source md5: ${SRC}\"",
        "echo \"file system md5: ${DST}\"",
        "test \"${SRC}\" = \"${DST}\"",
        "ls -la \"${DIR}\"",
        "lfs getstripe \"${DIR}/abi-check.bin\"",
        "echo \"${DIR}\" > /tmp/abi-check-dir"
      ]
    },
    {
      "id": "04-metadata-operations",
      "name": "Exercise metadata operations",
      "commands": [
        "DIR=$(cat /tmp/abi-check-dir)",
        "for i in $(seq 1 200); do echo payload-${i} > \"${DIR}/meta-${i}.txt\"; done",
        "ls -1 \"${DIR}\" | wc -l",
        "find \"${DIR}\" -name 'meta-*.txt' -delete",
        "ls -1 \"${DIR}\""
      ]
    },
    {
      "id": "05-sequential-throughput",
      "name": "Measure sequential read and write throughput",
      "commands": [
        "DIR=$(cat /tmp/abi-check-dir)",
        "SIZE_MB=${IO_SIZE_MB:-256}",
        "dd if=/dev/zero of=\"${DIR}/seq-write.bin\" bs=1M count=${SIZE_MB} conv=fsync 2>&1 | tail -1",
        "echo 3 > /proc/sys/vm/drop_caches",
        "dd if=\"${DIR}/seq-write.bin\" of=/dev/null bs=1M 2>&1 | tail -1"
      ]
    },
    {
      "id": "06-remount",
      "name": "Unmount and mount again",
      "commands": [
        "POINT=${MOUNT_POINT:-/mnt/fsx}",
        "DNS=${FSX_DNS_NAME:?FSX_DNS_NAME must be set}",
        "MOUNTNAME=${FSX_MOUNT_NAME:?FSX_MOUNT_NAME must be set}",
        "DIR=$(cat /tmp/abi-check-dir)",
        "umount \"${POINT}\"",
        "mount | grep lustre || echo 'unmounted'",
        "mount -t lustre -o noatime,flock \"${DNS}@tcp:/${MOUNTNAME}\" \"${POINT}\"",
        "md5sum \"${DIR}/abi-check.bin\"",
        "dmesg | grep -iE 'lustre|lnet' | tail -20 || true"
      ]
    },
    {
      "id": "07-cleanup",
      "name": "Remove the test data",
      "commands": [
        "DIR=$(cat /tmp/abi-check-dir)",
        "rm -rf \"${DIR}\"",
        "rm -f /tmp/abi-check.bin",
        "ls -1 $(dirname \"${DIR}\") | head"
      ]
    }
  ]
}
