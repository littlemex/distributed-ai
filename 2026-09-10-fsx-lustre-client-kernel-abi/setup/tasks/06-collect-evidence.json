{
  "name": "Collect the evidence for the report",
  "tasks": [
    {
      "id": "01-environment",
      "name": "Operating system, kernel and package origins",
      "commands": [
        "grep -E '^(NAME|VERSION)=' /etc/os-release",
        "uname -r",
        "dpkg-query -W -f='${Package} ${Version}\\n' 'lustre*' | sort",
        "for list in /etc/apt/sources.list.d/fsxlustreclientrepo*.list; do echo \"# ${list}\"; cat \"${list}\"; done",
        "apt-cache policy \"lustre-client-modules-$(uname -r)\" lustre-client-utils | grep -E '^[a-z]|Installed:|Candidate:'",
        "for pkg in \"lustre-client-modules-$(uname -r)\" lustre-client-utils; do echo \"${pkg} installed from: $(apt-cache policy \"${pkg}\" | awk '/\\*\\*\\*/{found=1; next} found && /http/{print $2, $3; exit}')\"; done"
      ]
    },
    {
      "id": "02-module-facts",
      "name": "Module metadata and load state",
      "commands": [
        "modinfo -F filename lustre",
        "modinfo -F version lustre",
        "modinfo -F vermagic lustre",
        "modinfo -F vermagic lnet",
        "lsmod | grep -E '^(lustre|lnet|ptlrpc|obdclass|libcfs|ksocklnd)' | sort",
        "lctl get_param -n version | head -3 || true"
      ]
    },
    {
      "id": "03-mount-state",
      "name": "Mount state and file system capacity",
      "allow_failure": true,
      "commands": [
        "POINT=${MOUNT_POINT:-/mnt/fsx}",
        "mount | grep lustre",
        "lfs df -h \"${POINT}\"",
        "lfs check servers || true"
      ]
    },
    {
      "id": "04-kernel-log",
      "name": "Kernel log lines for the client",
      "commands": [
        "dmesg | grep -iE 'lustre|lnet' | tail -40 || true"
      ]
    }
  ]
}
