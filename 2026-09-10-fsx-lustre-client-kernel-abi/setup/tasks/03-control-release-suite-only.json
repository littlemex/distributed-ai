{
  "name": "Control: attempt the documented install with only the release-matching suite",
  "tasks": [
    {
      "id": "01-install-for-running-kernel",
      "name": "Install the module package for the running kernel",
      "allow_failure": true,
      "commands": [
        "export DEBIAN_FRONTEND=noninteractive",
        "apt-get -o DPkg::Lock::Timeout=600 install -y \"lustre-client-modules-$(uname -r)\""
      ]
    },
    {
      "id": "02-metapackage-plan",
      "name": "Show what the module meta package would do to the kernel",
      "allow_failure": true,
      "commands": [
        "apt-cache policy lustre-client-modules-aws",
        "apt-get -o DPkg::Lock::Timeout=600 install -s lustre-client-modules-aws | grep -E '^(Inst|Conf) (lustre|linux-image|linux-modules|linux-aws)'"
      ]
    },
    {
      "id": "03-module-state",
      "name": "Confirm no Lustre module is present for the running kernel",
      "allow_failure": true,
      "commands": [
        "modinfo lustre",
        "echo \"modinfo exit: $?\""
      ]
    }
  ]
}
