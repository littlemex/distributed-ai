{
  "name": "Build a DKMS package and prove it follows a kernel update",
  "tasks": [
    {
      "id": "01-dependencies",
      "name": "Install the build dependencies, DKMS and the source package",
      "commands": [
        "export DEBIAN_FRONTEND=noninteractive",
        "apt-get -o DPkg::Lock::Timeout=600 update",
        "apt-get -o DPkg::Lock::Timeout=600 install -y module-assistant build-essential bzip2 debhelper libtool libyaml-dev libnl-genl-3-dev libselinux-dev libsnmp-dev libkeyutils-dev libmount-dev mpi-default-dev pkg-config autoconf automake quilt fakeroot flex bison python3-dev libssl-dev libreadline-dev rsync dkms",
        "apt-get -o DPkg::Lock::Timeout=600 install -y lustre-source lustre-client-utils \"linux-headers-$(uname -r)\"",
        "dkms --version",
        "echo \"running kernel: $(uname -r)\""
      ]
    },
    {
      "id": "02-build-dkms-package",
      "name": "Build the DKMS source package",
      "skip_if": "ls /usr/src/modules/lustre-client-modules-dkms_*.deb >/dev/null 2>&1",
      "commands": [
        "rm -rf /usr/src/modules",
        "tar -xjf /usr/src/lustre-*.tar.bz2 -C /usr/src",
        "cd /usr/src/modules/lustre",
        "# The DKMS package's Depends field in the source tree writes version constraints",
        "# without parentheses, which dpkg-gencontrol rejects. Fix the syntax before building.",
        "grep -rl 'linux-image >= ' debian/ | head -5",
        "sed -i -E 's/(linux-image(-amd64|-arm64)?) >= ([0-9.]+)/\\1 (>= \\3)/g' debian/control.main debian/control 2>/dev/null || true",
        "grep -o 'linux-image[^,|]*' debian/control.main | head -3",
        "START=$(date +%s)",
        "# binary-indep depends on the build stamp, which configures the tree, so the kernel",
        "# source and object trees have to be passed here as well.",
        "# The standard build path reads KERNEL_SRC and KERNEL_OBJ, unlike the module-assistant path which reads KSRC and KSRC_TREE.",
        "export KERNEL_SRC=\"/lib/modules/$(uname -r)/build\" KERNEL_OBJ=\"/lib/modules/$(uname -r)/build\"",
        "export BUILD_DKMS=true DEB_BUILD_PROFILES=\"${BUILD_PROFILES:-flock}\"",
        "fakeroot debian/rules binary-indep > /tmp/dkms-build.log 2>&1 || { echo 'BUILD FAILED'; tail -25 /tmp/dkms-build.log; exit 1; }",
        "echo \"build seconds: $(( $(date +%s) - START ))\"",
        "find /usr/src -maxdepth 2 -name 'lustre-client-modules-dkms_*.deb' -ls"
      ]
    },
    {
      "id": "03-install-dkms-package",
      "name": "Register the generated source tree with DKMS and build for the running kernel",
      "commands": [
        "# The generated DKMS package depends on a linux-image metapackage that Ubuntu does not",
        "# ship, so the tree it carries is registered with dkms directly instead.",
        "SRC=$(find /usr/src/modules/lustre/debian/lustre-client-modules-dkms/usr/src -maxdepth 1 -name 'lustre-client-modules-*' -type d | head -1)",
        "test -n \"${SRC}\"",
        "VERSION=$(basename \"${SRC}\" | sed 's/^lustre-client-modules-//')",
        "echo \"dkms source tree: ${SRC} version ${VERSION}\"",
        "test -f \"${SRC}/dkms.conf\"",
        "grep -E '^(PACKAGE_NAME|PACKAGE_VERSION|AUTOINSTALL)' \"${SRC}/dkms.conf\"",
        "rm -rf \"/usr/src/lustre-client-modules-${VERSION}\"",
        "cp -a \"${SRC}\" /usr/src/",
        "dkms status | grep lustre-client-modules || dkms add -m lustre-client-modules -v \"${VERSION}\"",
        "START=$(date +%s)",
        "dkms build -m lustre-client-modules -v \"${VERSION}\" -k \"$(uname -r)\" > /tmp/dkms-first-build.log 2>&1 || { echo 'DKMS BUILD FAILED'; tail -25 /tmp/dkms-first-build.log; exit 1; }",
        "echo \"dkms build seconds: $(( $(date +%s) - START ))\"",
        "dkms install -m lustre-client-modules -v \"${VERSION}\" -k \"$(uname -r)\" --force",
        "dkms status",
        "echo \"${VERSION}\" > /etc/task-runner-dkms-version"
      ]
    },
    {
      "id": "04-verify-running-kernel",
      "name": "Load the DKMS built module on the running kernel",
      "commands": [
        "modinfo -F filename lustre",
        "modinfo -F vermagic lustre",
        "test \"$(modinfo -F vermagic lustre | awk '{print $1}')\" = \"$(uname -r)\"",
        "umount -a -t lustre 2>/dev/null || true",
        "lctl network down 2>/dev/null || true",
        "lustre_rmmod 2>/dev/null || true",
        "modprobe lustre",
        "lsmod | grep -E '^(lustre|lnet|libcfs)' | sort",
        "lctl --version"
      ]
    },
    {
      "id": "05-install-another-kernel",
      "name": "Install a second kernel release and watch DKMS follow it",
      "commands": [
        "export DEBIAN_FRONTEND=noninteractive",
        "OTHER=${OTHER_KERNEL:?OTHER_KERNEL must be set, for example 6.8.0-1062-aws}",
        "test \"${OTHER}\" != \"$(uname -r)\"",
        "START=$(date +%s)",
        "apt-get -o DPkg::Lock::Timeout=600 install -y \"linux-image-${OTHER}\" \"linux-headers-${OTHER}\" > /tmp/second-kernel.log 2>&1",
        "echo \"kernel install seconds: $(( $(date +%s) - START ))\"",
        "grep -iE 'dkms|building|lustre' /tmp/second-kernel.log | tail -20 || true",
        "echo '--- dkms status after the kernel install ---'",
        "dkms status",
        "echo '--- modules DKMS placed for the new kernel ---'",
        "ls /lib/modules/${OTHER}/updates/dkms/ 2>/dev/null || ls -R /lib/modules/${OTHER}/updates 2>/dev/null | head -20",
        "test -n \"$(find /lib/modules/${OTHER} -name 'lustre.ko*' -print -quit)\"",
        "echo 'a module for the second kernel exists without any manual build step'"
      ],
      "skip_if": "test \"$(uname -r)\" = \"${OTHER_KERNEL}\""
    },
    {
      "id": "06-boot-second-kernel",
      "name": "Boot the second kernel",
      "skip_if": "test \"$(uname -r)\" = \"${OTHER_KERNEL}\"",
      "commands": [
        "OTHER=${OTHER_KERNEL:?OTHER_KERNEL must be set}",
        "submenu=$(grep -oP \"(?<=submenu ')[^']*\" /boot/grub/grub.cfg | head -1)",
        "entry=$(grep -oP \"(?<=menuentry ')[^']*${OTHER}[^']*\" /boot/grub/grub.cfg | grep -v recovery | head -1)",
        "test -n \"${submenu}\" && test -n \"${entry}\"",
        "sed -i \"s|^GRUB_DEFAULT=.*|GRUB_DEFAULT=\\\"${submenu}>${entry}\\\"|\" /etc/default/grub",
        "update-grub",
        "echo \"rebooting into ${OTHER}\"",
        "systemd-run --on-active=5 --unit=task-runner-reboot /sbin/reboot",
        "sleep 180"
      ]
    },
    {
      "id": "07-verify-second-kernel",
      "name": "Load and mount on the second kernel with no manual step",
      "commands": [
        "OTHER=${OTHER_KERNEL:?OTHER_KERNEL must be set}",
        "test \"$(uname -r)\" = \"${OTHER}\"",
        "modinfo -F filename lustre",
        "test \"$(modinfo -F vermagic lustre | awk '{print $1}')\" = \"$(uname -r)\"",
        "modprobe lustre",
        "lsmod | grep -E '^(lustre|lnet|libcfs)' | sort",
        "DNS=${FSX_DNS_NAME:?FSX_DNS_NAME must be set}",
        "MOUNTNAME=${FSX_MOUNT_NAME:?FSX_MOUNT_NAME must be set}",
        "POINT=${MOUNT_POINT:-/mnt/fsx}",
        "mkdir -p \"${POINT}\"",
        "mount -t lustre -o noatime,flock \"${DNS}@tcp:/${MOUNTNAME}\" \"${POINT}\"",
        "mountpoint -q \"${POINT}\"",
        "test \"$(stat -f -c %T \"${POINT}\")\" = \"lustre\"",
        "mount | grep lustre",
        "dd if=/dev/urandom of=/tmp/dkms-probe.bin bs=1M count=64 status=none",
        "SRC=$(md5sum /tmp/dkms-probe.bin | awk '{print $1}')",
        "cp /tmp/dkms-probe.bin \"${POINT}/dkms-probe-$(hostname).bin\"",
        "sync",
        "echo 3 > /proc/sys/vm/drop_caches",
        "DST=$(md5sum \"${POINT}/dkms-probe-$(hostname).bin\" | awk '{print $1}')",
        "echo \"source md5: ${SRC}\"",
        "echo \"file system md5: ${DST}\"",
        "test \"${SRC}\" = \"${DST}\"",
        "rm -f \"${POINT}/dkms-probe-$(hostname).bin\" /tmp/dkms-probe.bin",
        "umount \"${POINT}\"",
        "dkms status"
      ]
    }
  ]
}
