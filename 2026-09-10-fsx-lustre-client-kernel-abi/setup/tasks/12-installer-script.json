{
  "name": "Run the installer script and prove it follows a kernel update",
  "tasks": [
    {
      "id": "01-stage-installer",
      "name": "Place the installer on the host",
      "commands": [
        "test -f /opt/task-runner/files/lustre_installer.sh",
        "install -m 0755 /opt/task-runner/files/lustre_installer.sh /usr/local/sbin/lustre_installer.sh",
        "/usr/local/sbin/lustre_installer.sh --version"
      ]
    },
    {
      "id": "02-run-installer",
      "name": "Install the client with one command",
      "commands": [
        "START=$(date +%s)",
        "/usr/local/sbin/lustre_installer.sh -y",
        "echo \"installer seconds: $(( $(date +%s) - START ))\""
      ]
    },
    {
      "id": "03-idempotence",
      "name": "Run the installer again and confirm it changes nothing",
      "commands": [
        "START=$(date +%s)",
        "/usr/local/sbin/lustre_installer.sh -y | tee /tmp/second-run.log",
        "echo \"second run seconds: $(( $(date +%s) - START ))\"",
        "grep -E 'already' /tmp/second-run.log"
      ]
    },
    {
      "id": "04-mount",
      "name": "Mount the file system and verify data",
      "commands": [
        "DNS=${FSX_DNS_NAME:?FSX_DNS_NAME must be set}",
        "MOUNTNAME=${FSX_MOUNT_NAME:?FSX_MOUNT_NAME must be set}",
        "POINT=${MOUNT_POINT:-/mnt/fsx}",
        "mkdir -p \"${POINT}\"",
        "mount -t lustre -o noatime,flock \"${DNS}@tcp:/${MOUNTNAME}\" \"${POINT}\"",
        "mountpoint -q \"${POINT}\"",
        "test \"$(stat -f -c %T \"${POINT}\")\" = \"lustre\"",
        "mount | grep lustre",
        "dd if=/dev/urandom of=/tmp/probe.bin bs=1M count=128 status=none",
        "SRC=$(md5sum /tmp/probe.bin | awk '{print $1}')",
        "cp /tmp/probe.bin \"${POINT}/installer-probe-$(hostname).bin\"",
        "sync && echo 3 > /proc/sys/vm/drop_caches",
        "DST=$(md5sum \"${POINT}/installer-probe-$(hostname).bin\" | awk '{print $1}')",
        "echo \"source md5: ${SRC}\"",
        "echo \"file system md5: ${DST}\"",
        "test \"${SRC}\" = \"${DST}\"",
        "lfs check servers",
        "rm -f \"${POINT}/installer-probe-$(hostname).bin\" /tmp/probe.bin",
        "umount \"${POINT}\""
      ]
    },
    {
      "id": "05-kernel-update",
      "name": "Install another kernel and confirm DKMS follows with no extra command",
      "skip_if": "test \"$(uname -r)\" = \"${OTHER_KERNEL}\"",
      "commands": [
        "export DEBIAN_FRONTEND=noninteractive",
        "OTHER=${OTHER_KERNEL:?OTHER_KERNEL must be set}",
        "START=$(date +%s)",
        "apt-get -o DPkg::Lock::Timeout=600 install -y \"linux-image-${OTHER}\" \"linux-headers-${OTHER}\" > /tmp/kernel-update.log 2>&1",
        "echo \"kernel install seconds: $(( $(date +%s) - START ))\"",
        "grep -iE 'dkms|lustre' /tmp/kernel-update.log | head -10 || true",
        "dkms status -m lustre-client-modules",
        "test -n \"$(find /lib/modules/${OTHER} -name 'lustre.ko*' -print -quit)\"",
        "echo 'the module for the new kernel exists without running the installer again'"
      ]
    },
    {
      "id": "06-boot-new-kernel",
      "name": "Boot the new kernel",
      "skip_if": "test \"$(uname -r)\" = \"${OTHER_KERNEL}\"",
      "commands": [
        "OTHER=${OTHER_KERNEL:?OTHER_KERNEL must be set}",
        "submenu=$(grep -oP \"(?<=submenu ')[^']*\" /boot/grub/grub.cfg | head -1)",
        "entry=$(grep -oP \"(?<=menuentry ')[^']*${OTHER}[^']*\" /boot/grub/grub.cfg | grep -v recovery | head -1)",
        "test -n \"${submenu}\" && test -n \"${entry}\"",
        "sed -i \"s|^GRUB_DEFAULT=.*|GRUB_DEFAULT=\\\"${submenu}>${entry}\\\"|\" /etc/default/grub",
        "update-grub",
        "systemd-run --on-active=5 --unit=task-runner-reboot /sbin/reboot",
        "sleep 180"
      ]
    },
    {
      "id": "07-verify-new-kernel",
      "name": "Mount on the new kernel without touching the installer",
      "commands": [
        "OTHER=${OTHER_KERNEL:?OTHER_KERNEL must be set}",
        "test \"$(uname -r)\" = \"${OTHER}\"",
        "modinfo -F vermagic lustre",
        "test \"$(modinfo -F vermagic lustre | awk '{print $1}')\" = \"$(uname -r)\"",
        "DNS=${FSX_DNS_NAME:?FSX_DNS_NAME must be set}",
        "MOUNTNAME=${FSX_MOUNT_NAME:?FSX_MOUNT_NAME must be set}",
        "POINT=${MOUNT_POINT:-/mnt/fsx}",
        "mkdir -p \"${POINT}\"",
        "mount -t lustre -o noatime,flock \"${DNS}@tcp:/${MOUNTNAME}\" \"${POINT}\"",
        "mountpoint -q \"${POINT}\"",
        "test \"$(stat -f -c %T \"${POINT}\")\" = \"lustre\"",
        "mount | grep lustre",
        "dd if=/dev/urandom of=/tmp/probe2.bin bs=1M count=128 status=none",
        "SRC=$(md5sum /tmp/probe2.bin | awk '{print $1}')",
        "cp /tmp/probe2.bin \"${POINT}/installer-probe2-$(hostname).bin\"",
        "sync && echo 3 > /proc/sys/vm/drop_caches",
        "DST=$(md5sum \"${POINT}/installer-probe2-$(hostname).bin\" | awk '{print $1}')",
        "echo \"source md5: ${SRC}\"",
        "echo \"file system md5: ${DST}\"",
        "test \"${SRC}\" = \"${DST}\"",
        "rm -f \"${POINT}/installer-probe2-$(hostname).bin\" /tmp/probe2.bin",
        "umount \"${POINT}\"",
        "dkms status -m lustre-client-modules",
        "echo 'kernel updated and the file system still mounts, with no installer run in between'"
      ]
    },
    {
      "id": "08-binary-mode-message",
      "name": "Check the message the binary mode gives on this kernel",
      "allow_failure": true,
      "commands": [
        "/usr/local/sbin/lustre_installer.sh -y --mode binary --no-verify"
      ]
    }
  ]
}
