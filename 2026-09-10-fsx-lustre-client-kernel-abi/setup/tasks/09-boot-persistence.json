{
  "name": "Automatic mount across a reboot on the pinned kernel",
  "tasks": [
    {
      "id": "01-write-canary",
      "name": "Write a canary file and record its checksum",
      "skip_if": "test -f /etc/task-runner-boot-canary && md5sum -c /etc/task-runner-boot-canary",
      "commands": [
        "DNS=${FSX_DNS_NAME:?FSX_DNS_NAME must be set}",
        "MOUNTNAME=${FSX_MOUNT_NAME:?FSX_MOUNT_NAME must be set}",
        "POINT=${MOUNT_POINT:-/mnt/fsx}",
        "mkdir -p \"${POINT}\"",
        "mountpoint -q \"${POINT}\" || mount -t lustre -o noatime,flock \"${DNS}@tcp:/${MOUNTNAME}\" \"${POINT}\"",
        "FILE=\"${POINT}/boot-canary-$(hostname).bin\"",
        "dd if=/dev/urandom of=\"${FILE}\" bs=1M count=32 status=none conv=fsync",
        "md5sum \"${FILE}\" > /etc/task-runner-boot-canary",
        "cat /etc/task-runner-boot-canary"
      ]
    },
    {
      "id": "02-add-fstab-entry",
      "name": "Add the file system to fstab",
      "skip_if": "grep -q ' lustre ' /etc/fstab",
      "commands": [
        "DNS=${FSX_DNS_NAME:?FSX_DNS_NAME must be set}",
        "MOUNTNAME=${FSX_MOUNT_NAME:?FSX_MOUNT_NAME must be set}",
        "POINT=${MOUNT_POINT:-/mnt/fsx}",
        "echo \"${DNS}@tcp:/${MOUNTNAME} ${POINT} lustre defaults,noatime,flock,_netdev,x-systemd.automount 0 0\" >> /etc/fstab",
        "tail -1 /etc/fstab",
        "systemctl daemon-reload",
        "umount \"${POINT}\" || true",
        "mount -a",
        "mount | grep lustre"
      ]
    },
    {
      "id": "03-reboot",
      "name": "Reboot the client",
      "skip_if": "test -f /etc/task-runner-rebooted-for-persistence",
      "commands": [
        "touch /etc/task-runner-rebooted-for-persistence",
        "echo 'rebooting to test the automatic mount'",
        "systemd-run --on-active=5 --unit=task-runner-reboot /sbin/reboot",
        "# hold the step open so the reboot ends this run; re-running the task skips this step",
        "sleep 180"
      ]
    },
    {
      "id": "04-verify-after-reboot",
      "name": "Verify the kernel, the module and the mount after the reboot",
      "commands": [
        "POINT=${MOUNT_POINT:-/mnt/fsx}",
        "uptime -p",
        "echo \"running kernel: $(uname -r)\"",
        "test \"$(uname -r)\" = \"$(cat /etc/task-runner-target-kernel)\"",
        "systemctl is-active \"$(systemd-escape --path --suffix=mount \"${POINT}\")\" || true",
        "ls \"${POINT}\" >/dev/null",
        "mount | grep lustre",
        "lsmod | grep -E '^(lustre|lnet)' | sort",
        "md5sum -c /etc/task-runner-boot-canary",
        "dmesg | grep -iE 'lustre|lnet' | tail -8"
      ]
    },
    {
      "id": "05-cleanup",
      "name": "Remove the canary and the fstab entry",
      "commands": [
        "POINT=${MOUNT_POINT:-/mnt/fsx}",
        "rm -f \"${POINT}/boot-canary-$(hostname).bin\"",
        "sed -i '/ lustre /d' /etc/fstab",
        "tail -2 /etc/fstab",
        "rm -f /etc/task-runner-rebooted-for-persistence /etc/task-runner-boot-canary"
      ]
    }
  ]
}
