# Context-window profiles for Qwen/Qwen3.8-27B, selected at deploy time.
#
#   ./scripts/deploy.sh --context 262k        # or 131k | 1m   (default: 262k)
#   QWEN_CONTEXT=1m ./scripts/deploy.sh --only serving
#
# Window and concurrency are one decision, not two, which is why they live in the same
# table. The 16 full-attention layers hold 64 KiB of paged KV per token, so a sequence
# reserves the window times that, and the number of sequences that fit beside fp8 weights
# on four L40S follows from it. Setting one without the other is how the machine ends up
# either refusing long prompts or serving two requests at a time.
#
# Measured on this deployment (2026-08-26): under the 1M profile throughput saturated at
# two concurrent requests at 162 output tokens a second, which prices a token at about $26
# per million on a $15.2174/hour node. The shorter profiles exist to get that number down.
#
# YaRN is applied by deploy.sh only when the window exceeds the model's native 262144.
# Below native, rope scaling would trade short-context accuracy for reach nobody asked for.
#
# Applies to vLLM. The SGLang manifest takes the window from MAX_CONTEXT too, but its
# concurrency is set in its own manifest and does not read MAX_NUM_SEQS.

# The KV cache measured on this deployment is 30.34 GiB per rank, which at 16 KiB per token
# per rank is about 1.99M tokens in flight in total. That, not the sequence count, is the
# real capacity: vLLM pages KV per token, so the number of sequences that fit depends on how
# long they actually are. The per-profile counts below are sized for sequences near the
# window; short requests fit far more, and a burst of long ones is preempted and recomputed
# rather than refused.
case "${QWEN_CONTEXT:-262k}" in
  # Shortest useful profile. Chosen when concurrency matters more than reach: over 1,533
  # served requests on this deployment no prompt exceeded 50,000 tokens, so this still
  # leaves 2.6x headroom over anything actually asked for.
  131k)
    MAX_CONTEXT=131072
    MAX_NUM_SEQS=16
    ;;
  # Default. The model's native window, so no rope scaling is involved at all, and nine
  # concurrent sequences is more than the traffic this serves has ever needed at once.
  262k)
    MAX_CONTEXT=262144
    MAX_NUM_SEQS=9
    ;;
  # The long-context profile. YaRN stretches the window four-fold and a single sequence
  # reserves about 64 GiB of KV, so two is what fits. Use it for work that genuinely needs
  # the reach, and expect the throughput and the per-token cost of two-way concurrency.
  1m)
    MAX_CONTEXT=1048576
    MAX_NUM_SEQS=2
    ;;
  *)
    echo "unknown QWEN_CONTEXT '${QWEN_CONTEXT}': expected 131k, 262k or 1m" >&2
    exit 2
    ;;
esac

# What to optimise, which is a separate decision from how long the window is.
#
#   latency    - MTP self-speculative decoding on. Measured ~1.7x faster per token at one
#                request in flight, and it derates the scheduler's step budget to 2048
#                tokens, so aggregate throughput suffers. Right for interactive agents.
#   throughput - MTP off and a large step budget, with the sequence count raised. Right for
#                filling a machine that is running anyway with background or draft work.
#
# Measured on this deployment at the 262k window, 128-token replies, in-cluster client:
#
#   in flight   output tok/s   p50      $/Mtok     what it costs to go further
#   1            52.7          2.2 s    80.24      (MTP on it is 83.7 - see below)
#   9           223.8          5.1 s    18.89
#   16          306.7          6.7 s    13.78
#   32          352.9         11.6 s    11.98
#   48          395.7         15.5 s    10.68      the knee
#   64          404.9         20.2 s    10.44      +2% throughput for +30% latency
#   96          423.4         28.9 s     9.98      +7% over the knee for double the latency
#
# So the compute limit is around 48 concurrent: past it latency grows roughly linearly and
# throughput barely moves. KV is not the constraint for short requests - 48 sequences of a
# thousand tokens is 48k against a capacity near 2M - the GPU is.
#
# The two tunes are a real trade and not a free choice. At one request in flight MTP gives
# 83.7 output tokens a second against 52.7 without it, so turning it off to gain aggregate
# throughput makes every individual answer about 40% slower. Interactive agents feel that;
# batch work does not.
case "${QWEN_TUNE:-latency}" in
  latency)
    MAX_BATCHED_TOKENS=""
    SPEC_CONFIG='{"method": "mtp", "num_speculative_tokens": 3}'
    ;;
  throughput)
    MAX_NUM_SEQS="${QWEN_MAX_SEQS:-48}"
    MAX_BATCHED_TOKENS="${QWEN_BATCHED_TOKENS:-16384}"
    SPEC_CONFIG=""
    ;;
  *)
    echo "unknown QWEN_TUNE '${QWEN_TUNE}': expected latency or throughput" >&2
    exit 2
    ;;
esac
