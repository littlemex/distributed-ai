# Context-window, shape and tuning profiles for Qwen/Qwen3.6-35B-A3B, selected at deploy time.
#
#   ./scripts/deploy.sh --model qwen3.6-35b-a3b --context 262k --shape short --tune throughput
#
# This file said "window and concurrency are one decision" and derived the sequence count from the
# window's KV arithmetic. Measurement says that is the wrong pairing, and the error was expensive:
# the 262k profile capped the engine at 27 sequences, and raising it to 256 lifted the value the box
# retires per hour by 33% on 60-token requests, 18% on 300-token ones and 5% on 600-token ones.
# Every throughput figure taken before that was measuring this file.
#
# Concurrency belongs to the REQUEST SHAPE, not to the window. vLLM does not reserve max-model-len
# per sequence; it allocates KV per block on demand. So what bounds the sequence count is the KV a
# sequence actually holds, which is its own length -- 256 requests of 300 tokens hold 1.5 M tokens
# of KV against a 2.0 M pool, while 256 requests of 20,000 tokens would want 5.1 M and preempt each
# other. Hence a `--shape` axis, independent of `--context`.
#
# KV geometry, from the model's own config: 40 layers of which 10 are full attention (the pattern
# is three linear-attention layers then one full, repeated ten times), 2 KV heads, head_dim 256.
# That is 10 x 2 x 256 x 2 (K and V) x 2 bytes = 20 KiB of paged KV per token, against 64 KiB for
# Qwen3.8-27B. The engine reports a pool of about 2.0 M tokens at TP=2.

case "${QWEN_CONTEXT:-262k}" in
  # Kept for a caller who wants it, but narrowing the window buys almost nothing: vLLM does NOT
  # reserve max-model-len per sequence. The KV pool is a fixed amount taken from
  # gpu-memory-utilization and allocated per block on demand, so 262k -> 131k adds not one token of
  # capacity. What it does buy is a guard against a single enormous request preempting everything
  # else -- and that is better done as an admission threshold in the router than as an engine
  # setting, because there the oversized request can be sent to an API instead of refused.
  131k)
    MAX_CONTEXT=131072
    ;;
  # Default: the model's native window, so no rope scaling is involved at all.
  262k)
    MAX_CONTEXT=262144
    ;;
  # Available and deliberately not the default. YaRN's cost is paid on every request, including the
  # short ones, while the reach is used by none: over 1,533 requests on the previous deployment no
  # prompt exceeded 50,000 tokens against a native window of 262,144. The economics are worse than
  # the accuracy trade: a 1M sequence holds 40 GiB of KV, three fit, and at three in flight the
  # decode curve gives roughly 300-400 tokens a second -- over $10 per million output tokens, which
  # is more than the APIs this box exists to undercut at $4.12. A job that genuinely needs a
  # million tokens is a job for an API, not for this box.
  1m)
    MAX_CONTEXT=1048576
    ;;
  *)
    echo "unknown QWEN_CONTEXT '${QWEN_CONTEXT}': expected 131k, 262k or 1m" >&2
    exit 2
    ;;
esac

# How many sequences the engine admits at once, which follows the shape of the traffic rather than
# the window. The KV a request holds is its own length, so the ceiling is (pool / typical length),
# and the numbers below leave headroom for the tail of the distribution.
#
#   short  - a few hundred input tokens: classification, routing, short extraction. Measured 265,792
#            requests/hour at 300 in / 8 out from a three-pod generator, TTFT p90 5.3 s.
#   mixed  - the default. Enough seats for a short family to fill the machine, few enough that a
#            handful of multi-thousand-token requests cannot exhaust the KV pool.
#   long   - documents of ten thousand tokens and up. Fewer seats on purpose: at this length the box
#            is prefill-bound, extra seats buy queueing rather than throughput, and 20,000-token
#            requests at high concurrency preempt each other out of a 2.0 M-token pool.
#
# These are measured on this box at TP=2 x 2 replicas. `QWEN_MAX_SEQS` overrides any of them.
case "${QWEN_SHAPE:-mixed}" in
  short) MAX_NUM_SEQS=256 ;;
  mixed) MAX_NUM_SEQS=128 ;;
  long)  MAX_NUM_SEQS=32 ;;
  *)
    echo "unknown QWEN_SHAPE '${QWEN_SHAPE}': expected short, mixed or long" >&2
    exit 2
    ;;
esac
MAX_NUM_SEQS="${QWEN_MAX_SEQS:-$MAX_NUM_SEQS}"

# Two scheduler decisions that only matter when shapes are co-resident, and both default to off
# because the measurement that would justify turning them on is not done yet.
#
# A 20,000-token prefill sharing a replica with 300-token classification multiplies the short
# family's TTFT p95 by 5.85. `long_prefill_token_threshold` caps how much of one request enters a
# step, so the long prefill advances a slice at a time and the rest of the step's budget stays
# available -- which is the knob that fits this problem. Shrinking the step's TOTAL budget was tried
# first and only recovered a third of the damage while making the pure-short case worse, because it
# shrank the step for decodes too.
#
# `priority` orders admission and preemption so one family can be told to run only in the slack
# another leaves. That changes the accounting as much as the latency: work that consumes only
# otherwise-idle box time has a marginal cost near zero, so a family that cannot pay the box's full
# hourly rate can still be worth admitting. Clients must send the field; a non-zero priority against
# an fcfs engine is rejected.
LONG_PREFILL_THRESHOLD="${QWEN_LONG_PREFILL_THRESHOLD:-0}"
SCHEDULING_POLICY="${QWEN_SCHEDULING_POLICY:-}"

# What to optimise, which is a separate decision from how long the window is.
#
#   latency    - MTP self-speculative decoding on. Right for interactive agents.
#   throughput - MTP off and a large step budget, sequence count raised. Right for filling a
#                machine that is running anyway with background or draft work.
#
# On Qwen3.8-27B, MTP measured about 1.7x faster per token at one request in flight but derated
# vLLM's scheduler step budget to 2,048 tokens, which costs aggregate throughput. That trade is
# worth re-measuring here rather than assumed: this workload's decode is 0.5% of its tokens, so
# anything that slows prefill to speed decode is very likely a net loss. Default is therefore
# throughput, the opposite of the dense model's default, until the A/B says otherwise.
case "${QWEN_TUNE:-throughput}" in
  latency)
    MAX_BATCHED_TOKENS=""
    SPEC_CONFIG='{"method": "mtp", "num_speculative_tokens": 3}'
    ;;
  throughput)
    # 16,384 measured better than 2,048 for a single family. The smaller budget was tried because a
    # 20,000-token prefill co-resident with short requests multiplies their TTFT p95 by 5.85, and
    # chunking it into ten steps instead of two ought to bound that wait. It recovers only part of it
    # -- 5.85x becomes 3.61x -- and costs the pure-short case its own tail (p95 0.96 s -> 1.33 s), so
    # it is not the default. Co-residency of long and short is a placement problem, not a chunk-size
    # problem; see benchctl/docs/results-shape-surface.md.
    MAX_BATCHED_TOKENS="${QWEN_BATCHED_TOKENS:-16384}"
    SPEC_CONFIG=""
    ;;
  *)
    echo "unknown QWEN_TUNE '${QWEN_TUNE}': expected latency or throughput" >&2
    exit 2
    ;;
esac
