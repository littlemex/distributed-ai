# Context-window and tuning profiles for Qwen/Qwen3.6-35B-A3B, selected at deploy time.
#
#   ./scripts/deploy.sh --model qwen3.6-35b-a3b --context 262k --tune throughput
#
# Window and concurrency are one decision, not two, which is why they live in the same table.
#
# KV geometry, from the model's own config: 40 layers of which 10 are full attention (the pattern
# is three linear-attention layers then one full, repeated ten times), 2 KV heads, head_dim 256.
# That is 10 x 2 x 256 x 2 (K and V) x 2 bytes = 20 KiB of paged KV per token, against 64 KiB for
# Qwen3.8-27B. So a sequence of a given length reserves about a third as much, and the sequence
# counts below are correspondingly higher than that model's.
#
# The numbers here are STARTING POINTS derived from the geometry, not measurements. The measured
# table for this model belongs in FACTS.md once the sweep has run; until then, treat the
# concurrency figures as an upper bound to be checked rather than a result.

case "${QWEN_CONTEXT:-262k}" in
  # Kept for a caller who wants it, but narrowing the window buys almost nothing: vLLM does NOT
  # reserve max-model-len per sequence. The KV pool is a fixed amount taken from
  # gpu-memory-utilization and allocated per block on demand, so 262k -> 131k adds not one token of
  # capacity. What it does buy is a guard against a single enormous request preempting everything
  # else -- and that is better done as an admission threshold in the router than as an engine
  # setting, because there the oversized request can be sent to an API instead of refused.
  131k)
    MAX_CONTEXT=131072
    MAX_NUM_SEQS=48
    ;;
  # Default: the model's native window, so no rope scaling is involved at all.
  262k)
    MAX_CONTEXT=262144
    MAX_NUM_SEQS=27
    ;;
  # Available and deliberately not the default. YaRN's cost is paid on every request, including the
  # short ones, while the reach is used by none: over 1,533 requests on the previous deployment no
  # prompt exceeded 50,000 tokens against a native window of 262,144. The economics are worse than
  # the accuracy trade: a 1M sequence holds 40 GiB of KV, three fit, and at three in flight the
  # decode curve gives roughly 300-400 tokens a second -- over $10 per million output tokens, which
  # is more than the APIs this box exists to undercut at $4.12. A job that genuinely needs a
  # million tokens is a job for an API, not for this box.
  1m)
    MAX_CONTEXT=1048576
    MAX_NUM_SEQS=6
    ;;
  *)
    echo "unknown QWEN_CONTEXT '${QWEN_CONTEXT}': expected 131k, 262k or 1m" >&2
    exit 2
    ;;
esac

# What to optimise, which is a separate decision from how long the window is.
#
#   latency    - MTP self-speculative decoding on. Right for interactive agents.
#   throughput - MTP off and a large step budget, sequence count raised. Right for filling a
#                machine that is running anyway with background or draft work.
#
# On Qwen3.8-27B, MTP measured about 1.7x faster per token at one request in flight but derated
# vLLM's scheduler step budget to 2,048 tokens, which costs aggregate throughput. That trade is
# worth re-measuring here rather than assumed: this workload's decode is 0.5% of its tokens, so
# anything that slows prefill to speed decode is very likely a net loss. Default is therefore
# throughput, the opposite of the dense model's default, until the A/B says otherwise.
case "${QWEN_TUNE:-throughput}" in
  latency)
    MAX_BATCHED_TOKENS=""
    SPEC_CONFIG='{"method": "mtp", "num_speculative_tokens": 3}'
    ;;
  throughput)
    MAX_NUM_SEQS="${QWEN_MAX_SEQS:-$MAX_NUM_SEQS}"
    MAX_BATCHED_TOKENS="${QWEN_BATCHED_TOKENS:-16384}"
    SPEC_CONFIG=""
    ;;
  *)
    echo "unknown QWEN_TUNE '${QWEN_TUNE}': expected latency or throughput" >&2
    exit 2
    ;;
esac
