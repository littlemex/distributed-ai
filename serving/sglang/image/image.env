# Single source for the SGLang custom image. build.sh and deploy.sh both source this.
# SGLANG_COMMIT is an UPSTREAM sgl-project/sglang commit SHA (NOT this repo's SHA). No :latest.
BASE_IMAGE=lmsysorg/sglang@sha256:REPLACE_WITH_PINNED_DIGEST
SGLANG_COMMIT=REPLACE_WITH_UPSTREAM_SGLANG_FULL_SHA
ECR_REPO=qwen-sglang
TAG=sglang-REPLACE12-dflash2
