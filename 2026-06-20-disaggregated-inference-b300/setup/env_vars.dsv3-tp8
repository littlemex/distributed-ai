#!/usr/bin/env bash
# ② DeepSeek-V3 再現用 env_vars (先行 repo と同一モデル, 1P+1D)
#   source setup/env_vars.dsv3

# ----- AWS / ECR (自アカウント, fastapi pin 入り -fix1 image) -----
export AWS_REGION="us-west-2"
export ACCOUNT="776010787911"
export REGISTRY="${ACCOUNT}.dkr.ecr.${AWS_REGION}.amazonaws.com/"
export IMAGE="vllm-uccl-ep"
export TAG="vllm0.21.0-uccl-0dc87eb-cu13-b300-fix1"
export FULL_IMAGE="${REGISTRY}${IMAGE}:${TAG}"

# ----- Cluster -----
export NAMESPACE="akazawt-disagg"
export INSTANCE_TYPE="p6-b300.48xlarge"
export NUM_GPU_PER_NODE=8
export NUM_EFA_PER_NODE=16

# ----- Model: DeepSeek-V3-0324 (先行 repo と同一, 671B MoE, gated) -----
export MODEL="deepseek-ai/DeepSeek-V3-0324"

# ----- Topology: 1 prefill + 1 decode (2 nodes) + proxy -----
export PREFILL_NODE="ip-10-3-107-212.us-west-2.compute.internal"
export PREFILL_IP="10.3.107.212"
export DECODE_NODE_0="ip-10-3-109-107.us-west-2.compute.internal"
export DECODE_0_IP="10.3.109.107"

# ----- vLLM serve flags (先行 repo 準拠: MoE EP=8, TP=4/DP=2) -----
export TENSOR_PARALLEL_SIZE=8
export DATA_PARALLEL_SIZE=1
export GPU_MEMORY_UTILIZATION=0.85
export MAX_MODEL_LEN=16384
export NUM_GPU_BLOCKS_OVERRIDE=30000
export PREFILL_BACKEND="deepep_high_throughput"
export DECODE_BACKEND="deepep_low_latency"
