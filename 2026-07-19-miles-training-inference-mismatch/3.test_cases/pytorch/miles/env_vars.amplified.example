# ============================================================
# miles on EKS - Environment (mismatch study: AMPLIFIED, no correction)
#
# Same Qwen3-4B bf16 setup as the baseline, but the rollout KV cache is
# quantized to fp8_e5m2. That injects a controlled numerical-path difference
# between the SGLang rollout and the Megatron training forward, raising the
# training-inference mismatch (mis_kl) by ~50x (6e-4 -> ~3e-2) WITHOUT touching
# weight sync. At a learning rate that is stable in bf16 (1e-5), this amplified
# mismatch diverges and drives the policy to collapse -- reproducing the
# paper's "mismatch is an optimization problem" phenomenon in a controllable way.
#
# No mismatch correction is applied here (measurement-only config): this is the
# "disease" arm. See env_vars.tis.example for the "cure" arm.
#
#   cp env/env_vars.amplified.example env_vars && vim env_vars
# ============================================================

# ----- AWS / ECR -----
export AWS_REGION="${AWS_REGION:-$(aws configure get region)}"
export AWS_ACCOUNT_ID="$(aws sts get-caller-identity --query Account --output text)"
export REGISTRY="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/"
export IMAGE="miles-hyperpod"
export TAG="miles-dev202607182122-efa1.48"
export FULL_IMAGE="${REGISTRY}${IMAGE}:${TAG}"

# ----- HuggingFace -----
export HF_TOKEN=""   # <-- Set your HuggingFace token here

# ----- Model (Qwen3-4B dense, bf16 weights; KV cache quantized at rollout) -----
export MODEL_NAME="Qwen/Qwen3-4B"
export MODEL_LOCAL="/fsx/models/Qwen3-4B"
export MODEL_DIST="/fsx/models/Qwen3-4B_torch_dist"
export COLOCATE="true"
export TP_SIZE=1
export PP_SIZE=1
export CP_SIZE=1
export EP_SIZE=1
export ROLLOUT_NUM_GPUS=8
export ROLLOUT_GPUS_PER_ENGINE=1
export ACTOR_NUM_NODES=1
export ACTOR_GPUS_PER_NODE=8
export MAX_TOKENS_PER_GPU=8192
export ROLLOUT_MAX_RESPONSE_LEN=8192
export MODEL_SCRIPT="qwen3-4B.sh"

# ----- Cluster -----
export NAMESPACE="default"
export FSX_CLAIM="fsx-claim"
export NUM_NODES=1
export GPUS_PER_NODE=8
export TOTAL_GPUS=$((NUM_NODES * GPUS_PER_NODE))

# ----- Training -----
export PROMPT_DATA="/fsx/data/dapo-math-17k/dapo-math-17k.jsonl"
export EVAL_DATA="/fsx/data/aime-2024/aime-2024.jsonl"
export CHECKPOINT_DIR="/fsx/runs/amplified/ckpt"
export SAVE_INTERVAL=1000
export NUM_ROLLOUT=30
export ROLLOUT_BATCH_SIZE=16
export N_SAMPLES_PER_PROMPT=8
export GLOBAL_BATCH_SIZE=128
export NUM_STEPS_PER_ROLLOUT=1
# 1e-5 is STABLE in bf16 (the bf16 entropy-collapse threshold is ~1.575e-5).
# With KV fp8 amplification, the only changed variable vs the bf16 1e-5 run is
# the mismatch magnitude, so a collapse here is attributable to the mismatch.
export LEARNING_RATE="1e-5"
export ROLLOUT_TEMPERATURE=1.0

# ----- Reward -----
export RM_TYPE="deepscaler"

# ============================================================
# Mismatch-study additions
# ============================================================
export TENSORBOARD_DIR="/fsx/tb/amplified"
# --sglang-kv-cache-dtype fp8_e5m2: quantize the rollout KV cache to fp8. e5m2
# (2-bit mantissa) is chosen over e4m3 for a larger quantization error. This is
# dynamic at inference and never interacts with weight sync, so it avoids the
# fp8-WEIGHT rollout path (which needs a compressed-tensors checkpoint and a
# SGLang /post_process_weights endpoint that SGLang 0.5.12 does not expose).
# A side effect: FlashAttention-3 does not support fp8_e5m2, so SGLang falls
# back to the triton attention backend -- a second numerical-path difference
# from the trainer, which further widens the mismatch.
# Config is measurement-only (use_tis/use_rs=false): mismatch is measured but
# NOT corrected. This is the collapse arm.
export EXTRA_TRAIN_ARGS="--use-tensorboard --get-mismatch-metrics --custom-tis-function-path examples.train_infer_mismatch_helper.mis.compute_mis_weights_with_cp --custom-config-path /fsx/configs/mis_metrics_only.yaml --seed 1234 --rollout-seed 42 --attention-dropout 0 --hidden-dropout 0 --sglang-kv-cache-dtype fp8_e5m2"
