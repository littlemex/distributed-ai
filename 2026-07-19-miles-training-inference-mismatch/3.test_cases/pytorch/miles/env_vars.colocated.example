# ============================================================
# miles on EKS - Environment (mismatch study: BASELINE, measurement-only)
#
# Single-node colocated Qwen3-4B GRPO. Training (Megatron) and rollout (SGLang)
# share 8 GPUs. This is the mismatch-study baseline: the loss is the unmodified
# GRPO objective, and the training-inference mismatch metrics are computed
# ALONGSIDE it (never fed back into the loss) via --get-mismatch-metrics with a
# measurement-only config (use_tis=false / use_rs=false).
#
# Copy to env_vars and fill in HF_TOKEN / paths:
#   cp env/env_vars.baseline.example env_vars && vim env_vars
# ============================================================

# ----- AWS / ECR -----
# Region and account are derived from your current AWS credentials/config so
# nothing environment-specific is hard-coded. Override AWS_REGION if needed.
export AWS_REGION="${AWS_REGION:-$(aws configure get region)}"
export AWS_ACCOUNT_ID="$(aws sts get-caller-identity --query Account --output text)"
export REGISTRY="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/"
export IMAGE="miles-hyperpod"
export TAG="miles-dev202607182122-efa1.48"   # pinned image tag; avoid ":latest"
export FULL_IMAGE="${REGISTRY}${IMAGE}:${TAG}"

# ----- HuggingFace -----
export HF_TOKEN=""   # <-- Set your HuggingFace token here

# ----- Model (Qwen3-4B dense, bf16) -----
export MODEL_NAME="Qwen/Qwen3-4B"
export MODEL_LOCAL="/fsx/models/Qwen3-4B"              # SGLang rollout init (--hf-checkpoint)
export MODEL_DIST="/fsx/models/Qwen3-4B_torch_dist"    # Megatron training (--ref-load), bf16
export COLOCATE="true"
export TP_SIZE=1
export PP_SIZE=1
export CP_SIZE=1
export EP_SIZE=1
export ROLLOUT_NUM_GPUS=8
export ROLLOUT_GPUS_PER_ENGINE=1
export ACTOR_NUM_NODES=1
export ACTOR_GPUS_PER_NODE=8
export MAX_TOKENS_PER_GPU=8192
export ROLLOUT_MAX_RESPONSE_LEN=8192
export MODEL_SCRIPT="qwen3-4B.sh"

# ----- Cluster -----
export NAMESPACE="default"
export FSX_CLAIM="fsx-claim"
export NUM_NODES=1
export GPUS_PER_NODE=8
export TOTAL_GPUS=$((NUM_NODES * GPUS_PER_NODE))

# ----- Training -----
export PROMPT_DATA="/fsx/data/dapo-math-17k/dapo-math-17k.jsonl"
export EVAL_DATA="/fsx/data/aime-2024/aime-2024.jsonl"
# Each run MUST get its own CHECKPOINT_DIR: --load otherwise tries to resume a
# scheduler built for a different total-iteration count. train_iters = num_rollout
# here (16 x 8 // 128 = 1 step/rollout), so NUM_ROLLOUT == optimizer steps.
export CHECKPOINT_DIR="/fsx/runs/baseline/ckpt"
export SAVE_INTERVAL=1000
export NUM_ROLLOUT=100
export ROLLOUT_BATCH_SIZE=16
export N_SAMPLES_PER_PROMPT=8
export GLOBAL_BATCH_SIZE=128
export NUM_STEPS_PER_ROLLOUT=1
export LEARNING_RATE="1e-6"
export ROLLOUT_TEMPERATURE=1.0

# ----- Reward -----
export RM_TYPE="deepscaler"

# ============================================================
# Mismatch-study additions (measurement-only, loss unchanged)
# These drive the recipe's EXTRA_TRAIN_ARGS extension point (see
# recipe/run_grpo_qwen3_4b.hooks.patch). TENSORBOARD_DIR is forwarded into the
# Ray runtime env by the recipe so --use-tensorboard writes event files onto
# shared storage.
# ============================================================
export TENSORBOARD_DIR="/fsx/tb/baseline"
# --get-mismatch-metrics measures the rollout-vs-training KL / importance ratio
# WITHOUT changing the loss. Its assert requires --custom-tis-function-path even
# for metrics-only.
# GOTCHA 1: the function path must be a pure DOTTED module path
#   (examples.train_infer_mismatch_helper.mis.compute_mis_weights_with_cp), NOT
#   the "file.py:func" form: SLIME's load_function does rpartition(".") +
#   import_module, so "mis.py:func" fails with ModuleNotFoundError at train()
#   (the rollout still runs, so it fails late). /root/miles is on PYTHONPATH (set via runtime-env; not baked into the image).
# GOTCHA 2: --custom-config-path supplies the TIS/RS parameters the function
#   reads off `args`; without it it dies with AttributeError on tis_lower_bound.
#   mis_metrics_only.yaml has use_tis/use_rs=false, so the loss stays the
#   unmodified GRPO baseline while the mismatch metrics are still computed.
# GOTCHA 3: RL fine-tuning leaves dropout=0.1 on by default, which makes ppo_kl
#   ~0.30 (old_log_probs come from an eval-mode forward with dropout OFF; the
#   loss log_probs from a train-mode forward with dropout ON). Set dropout=0 so
#   ppo_kl reflects real off-policy drift, not a dropout artefact. mis_kl is
#   independent of dropout.
# Seeds are pinned (== SLIME defaults) so prompt order and sampling are identical
# across runs and only the studied variable differs.
export EXTRA_TRAIN_ARGS="--use-tensorboard --get-mismatch-metrics --custom-tis-function-path examples.train_infer_mismatch_helper.mis.compute_mis_weights_with_cp --custom-config-path /fsx/configs/mis_metrics_only.yaml --seed 1234 --rollout-seed 42 --attention-dropout 0 --hidden-dropout 0"
