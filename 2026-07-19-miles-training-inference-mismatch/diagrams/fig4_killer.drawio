" width="880" height="34" as="geometry"/></mxCell><mxCell id="c382" value="about 10 steps of warning" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#B7791F;strokeColor=none;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;;fontFamily=Helvetica;fontSize=25;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="643.7931034482758" y="196" width="400" height="56" as="geometry"/></mxCell><mxCell id="c383" value="in 2 of the 3 uncorrected runs" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#5A7A6B;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=24;" vertex="1" parent="1"><mxGeometry x="643.7931034482758" y="256" width="440" height="32" as="geometry"/></mxCell><mxCell id="c384" value="no correction" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#C0392B;strokeColor=none;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;;fontFamily=Helvetica;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1300" y="210" width="260" height="60" as="geometry"/></mxCell><mxCell id="c385" value="mismatch peaks between&lt;br&gt;2.85 and 13.7,&lt;br&gt;up from 0.03" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#14442F;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=25;" vertex="1" parent="1"><mxGeometry x="1300" y="280" width="540" height="100" as="geometry"/></mxCell><mxCell id="c386" value="with TIS" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#1E7E5A;strokeColor=none;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;;fontFamily=Helvetica;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1300" y="400" width="260" height="60" as="geometry"/></mxCell><mxCell id="c387" value="held between&lt;br&gt;0.07 and 0.13,&lt;br&gt;reward survives" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#14442F;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=25;" vertex="1" parent="1"><mxGeometry x="1300" y="470" width="540" height="100" as="geometry"/></mxCell><mxCell id="c388" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B7791F;strokeWidth=4;shadow=1;;fontFamily=Helvetica;fontSize=24;" vertex="1" parent="1"><mxGeometry x="1290" y="596" width="560" height="264" as="geometry"/></mxCell><mxCell id="c389" value="READ THIS CAREFULLY" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#B7791F;strokeColor=none;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;;fontFamily=Helvetica;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1320" y="622" width="400" height="56" as="geometry"/></mxCell><mxCell id="c390" value="The reward is noisy step to step, so&lt;br&gt;a single dip is not collapse. Using a&lt;br&gt;5-step average, reward halves&lt;br&gt;around step 21 to 23 while the&lt;br&gt;metric tripled at 11 to 13." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#14442F;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=25;" vertex="1" parent="1"><mxGeometry x="1320" y="692" width="500" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>