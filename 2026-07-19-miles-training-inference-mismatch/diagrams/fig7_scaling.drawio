lor=#5A7A6B;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=24;" vertex="1" parent="1"><mxGeometry x="110" y="455.0" width="170" height="120" as="geometry"/></mxCell><mxCell id="c42" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF7F0;strokeColor=#CDE9DC;strokeWidth=2;shadow=1;;fontFamily=Helvetica;fontSize=24;" vertex="1" parent="1"><mxGeometry x="1140" y="176" width="700" height="220" as="geometry"/></mxCell><mxCell id="c43" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1E7E5A;strokeColor=none;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;;fontFamily=Helvetica;fontSize=30;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1180" y="208" width="56" height="56" as="geometry"/></mxCell><mxCell id="c44" value="alpha = 1  independent" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#14442F;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=27;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1256" y="212" width="560" height="34" as="geometry"/></mxCell><mxCell id="c45" value="Independent gaps: variances add.&lt;br&gt;&lt;br&gt;variance  =  T  x  sigma squared" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#14442F;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=25;" vertex="1" parent="1"><mxGeometry x="1180" y="268" width="640" height="130" as="geometry"/></mxCell><mxCell id="c46" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF7F0;strokeColor=#CDE9DC;strokeWidth=2;shadow=1;;fontFamily=Helvetica;fontSize=24;" vertex="1" parent="1"><mxGeometry x="1140" y="420" width="700" height="220" as="geometry"/></mxCell><mxCell id="c47" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#C0392B;strokeColor=none;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;;fontFamily=Helvetica;fontSize=30;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1180" y="452" width="56" height="56" as="geometry"/></mxCell><mxCell id="c48" value="alpha = 2  worst case" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#14442F;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=27;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1256" y="456" width="560" height="34" as="geometry"/></mxCell><mxCell id="c49" value="Same bias b on every token,&lt;br&gt;so the sum is b x T.&lt;br&gt;&lt;br&gt;variance  =  T squared  x  var of b" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#14442F;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=25;" vertex="1" parent="1"><mxGeometry x="1180" y="508" width="640" height="140" as="geometry"/></mxCell><mxCell id="c50" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2FA374;strokeWidth=4;shadow=1;;fontFamily=Helvetica;fontSize=24;" vertex="1" parent="1"><mxGeometry x="1140" y="664" width="700" height="244" as="geometry"/></mxCell><mxCell id="c51" value="The data sits at alpha near 1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#1E7E5A;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=28;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1180" y="690" width="620" height="40" as="geometry"/></mxCell><mxCell id="c52" value="far from the alpha = 2 bound, which any&lt;br&gt;data below it satisfies trivially.&lt;br&gt;&lt;br&gt;So cap the ratio per token first." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#14442F;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=25;" vertex="1" parent="1"><mxGeometry x="1180" y="744" width="640" height="150" as="geometry"/></mxCell><mxCell id="c53" value="step 0 only" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#8A9691;strokeColor=none;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;;fontFamily=Helvetica;fontSize=25;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="936" width="300" height="56" as="geometry"/></mxCell><mxCell id="c54" value="raw exponent under 1.3 in all 12" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#8A9691;strokeColor=none;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;;fontFamily=Helvetica;fontSize=25;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="936" width="460" height="56" as="geometry"/></mxCell><mxCell id="c55" value="so no hidden T-squared component is present" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#5A7A6B;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=25;" vertex="1" parent="1"><mxGeometry x="884" y="940" width="980" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>