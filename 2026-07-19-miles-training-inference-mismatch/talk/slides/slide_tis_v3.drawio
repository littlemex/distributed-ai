        <mxCell id="RlblTxt" value="the cap removes the runaway; no single sample can dominate &#8594; update stays bounded" style="text;html=1;align=center;verticalAlign=top;fontSize=24;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1430" y="656" width="400" height="120" as="geometry" />
        </mxCell>

        <mxCell id="capR" value="Clipping is simple: it just caps each sample&#39;s weight. That is enough, because collapse is driven by a few extreme samples &#8212; cap them and the feedback loop cannot run away." style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1010" y="790" width="820" height="130" as="geometry" />
        </mxCell>

        <mxCell id="footnote" value="TIS does not remove the mismatch; it caps how much any one sample can push the gradient. arXiv:2602.01826 notes it prolongs the stable window, and pairs it with learning-rate scheduling." style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontColor=#777777;" vertex="1" parent="1">
