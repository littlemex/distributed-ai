ight="24" as="geometry"/></mxCell><mxCell id="c30" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#C0392B;strokeColor=#FFFFFF;strokeWidth=3;;fontFamily=Helvetica;fontSize=24;" vertex="1" parent="1"><mxGeometry x="636.4571428571428" y="708" width="24" height="24" as="geometry"/></mxCell><mxCell id="c31" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#14442F;strokeColor=#FFFFFF;strokeWidth=3;;fontFamily=Helvetica;fontSize=24;" vertex="1" parent="1"><mxGeometry x="532.1714285714286" y="702" width="36" height="36" as="geometry"/></mxCell><mxCell id="c32" value="undetectable" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#5A7A6B;strokeColor=none;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;;fontFamily=Helvetica;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="840" y="676" width="300" height="52" as="geometry"/></mxCell><mxCell id="c33" value="slope of |mismatch| vs absolute token position (arbitrary units)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#5A7A6B;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=24;" vertex="1" parent="1"><mxGeometry x="120" y="860" width="1000" height="34" as="geometry"/></mxCell><mxCell id="c34" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B7791F;strokeWidth=4;shadow=1;;fontFamily=Helvetica;fontSize=24;" vertex="1" parent="1"><mxGeometry x="1240" y="180" width="600" height="780" as="geometry"/></mxCell><mxCell id="c35" value="RETRACTED" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#C0392B;strokeColor=none;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;;fontFamily=Helvetica;fontSize=25;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1272" y="206" width="460" height="56" as="geometry"/></mxCell><mxCell id="c36" value="a single-seed (1234) within-run bootstrap CI excluded zero, so the original conclusion was &quot;quantization flips the sign&quot;." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#14442F;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=24;" vertex="1" parent="1"><mxGeometry x="1272" y="274" width="540" height="90" as="geometry"/></mxCell><mxCell id="c37" value="seed 42 alone gave -2.31e-08 -- the opposite conclusion. retracted." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#C0392B;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1272" y="372" width="540" height="90" as="geometry"/></mxCell><mxCell id="c38" value="why: within-run resampling only captures position noise inside a single run, not seed-to-seed variance -- which is what the sign question actually depends on." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#5A7A6B;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=24;" vertex="1" parent="1"><mxGeometry x="1272" y="468" width="540" height="150" as="geometry"/></mxCell><mxCell id="c39" value="the 4-seed comparison on the left is the corrected version: bf16 is robustly negative; fp8 arms are not detectable one way or the other." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#14442F;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=24;" vertex="1" parent="1"><mxGeometry x="1272" y="630" width="540" height="90" as="geometry"/></mxCell><mxCell id="c40" value="one more correction -- ask" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#5A7A6B;strokeColor=none;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;;fontFamily=Helvetica;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1272" y="730" width="540" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="12 seed floor" id="p12"><mxGraphModel dx="2000" dy="1200" grid="0" page="1" pageWidth="1920" pageHeight="1080" background="#F4FBF7" math="0"><root><mxCell id="0"/><mxC