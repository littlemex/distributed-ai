" height="56" as="geometry"/></mxCell><mxCell id="c10" value="KV fp8" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#14442F;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="460" width="320" height="44" as="geometry"/></mxCell><mxCell id="c11" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#C0392B;strokeColor=none;shadow=1;;fontFamily=Helvetica;fontSize=24;" vertex="1" parent="1"><mxGeometry x="460" y="494" width="1093.9431585194554" height="56" as="geometry"/></mxCell><mxCell id="c12" value="0.031" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#14442F;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=28;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1573.9431585194554" y="494" width="220" height="56" as="geometry"/></mxCell><mxCell id="c13" value="roughly 45-55x in both forks (single seed each)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#C0392B;strokeColor=none;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;;fontFamily=Helvetica;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="590" width="980" height="60" as="geometry"/></mxCell><mxCell id="c14" value="same direction, same order of magnitude in both forks (miles is a fork of slime)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#5A7A6B;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=24;" vertex="1" parent="1"><mxGeometry x="120" y="664" width="1600" height="34" as="geometry"/></mxCell><mxCell id="c15" value="* baseline is LR 1e-6, the fp8 arm LR 1e-5 -- quoted at step 0, before the LR can matter" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#C0392B;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=24;" vertex="1" parent="1"><mxGeometry x="120" y="702" width="1600" height="34" as="geometry"/></mxCel