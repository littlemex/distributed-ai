xCell><mxCell id="c37" value="EP=1 fixes generation" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#14442F;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=28;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1252" y="686" width="560" height="48" as="geometry"/></mxCell><mxCell id="c38" value="and then needs 108 GiB per&lt;br&gt;rank to train, against 140" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#5A7A6B;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=26;" vertex="1" parent="1"><mxGeometry x="1252" y="744" width="560" height="130" as="geometry"/></mxCell><mxCell id="c39" value="Until this week this slide said the cause was unresolved.&lt;br&gt;The fix was to stop looking inside miles." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#5A7A6B;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=26;" vertex="1" parent="1"><mxGeometry x="940" y="958" width="900" height="56" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="16 takeaways" id="p16"><mxGraphModel dx="2000" dy="1200" grid="0" page="1" pageWidth="1920" pageHeight="1080" background="#F4FBF7" math="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4FBF7;strokeColor=none;;fontFamily=Helvetica;fontSize=24;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1920" height="1080" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1E7E5A;strokeColor=none;;fontFamily=Helvetica;fontSize=24;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1920" height="128" as="geometry"/></mxCell><mxCell id="c3" value="Three pillars, three honest lines" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#FFFFFF;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=40;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="64" y="24" width="1792" height="48" as="geometry"/></mxCell><mxCell id="c4" value="What to carry out of this talk if you remember nothing else." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#CDE9DC;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=25;" vertex="1" parent="1"><mxGeometry x="64" y="74" width="1792" height="34" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B7791F;strokeWidth=4;shadow=1;;fontFamily=Helvetica;fontSize=24;" vertex="1" parent="1"><mxGeometry x="80" y="220" width="1760" height="250" as="geometry"/></mxCell><mxCell id="c6" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#B7791F;strokeColor=none;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;;fontFamily=Helvetica;fontSize=30;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="260" width="80" height="80" as="geometry"/></mxCell><mxCell id="c7" value="CPU / GIL bottleneck" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#14442F;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=30;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="232" y="250" width="1500" height="50" as="geometry"/></mxCell><mxCell id="c8" value="An open problem we did not measure. The negative-control experiment exists as a design, not as a result -- say so, do not paper over it." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#14442F;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=25;" vertex="1" parent="1"><mxGeometry x="232" y="312" width="1560" height="130" as="geometry"/></mxCell><mxCell id="c9" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B7791F;strokeWidth=4;shadow=1;;fontFamily=Helvetica;fontSize=24;" vertex="1" parent="1"><mxGeometry x="80" y="500" width="1760" height="250" as="geometry"/></mxCell><mxCell id="c10" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#B7791F;strokeColor=none;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;;fontFamily=Helvetica;fontSize=30;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="540" width="80" height="80" as="geometry"/></mxCell><mxCell id="c11" value="weight sync placement" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#14442F;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=30;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="232" y="530" width="1500" height="50" as="geometry"/></mxCell><mxCell id="c12" value="Disaggregated is 2.8x faster at TP1 on H200 with miles (0.170s vs 0.482s), and only colocated also flushes the KV cache -- so that is the placement's cost, not the transfer's. TP1 only, one framework, one cluster. Sync is under 1% of a cycle either way. The number exists at all because the recipe could not previously run this arm." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#14442F;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=25;" vertex="1" parent="1"><mxGeometry x="232" y="592" width="1560" height="130" as="geometry"/></mxCell><mxCell id="c13" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C0392B;strokeWidth=4;shadow=1;;fontFamily=Helvetica;fontSize=24;" vertex="1" parent="1"><mxGeometry x="80" y="780" width="1760" height="250" as="geometry"/></mxCell><mxCell id="c14" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#C0392B;strokeColor=none;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;;fontFamily=Helvetica;fontSize=30;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="820" width="80" height="80" as="geometry"/></mxCell><mxCell id="c15" value="training-inference numerical mismatch" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#14442F;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=30;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="232" y="810" width="1500" height="50" as="geometry"/></mxCell><mxCell id="c16" value="Real, reproducible across seeds and separate hardware (fork-to-fork, not independent implementations), and physically attributable to KV quantization dtype. Mismatch tends to diverge before the policy collapses. TIS is an empirically confirmed defense." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#14442F;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=25;" vertex="1" parent="1"><mxGeometry x="232" y="872" width="1560" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="17 qa" id="p17"><mxGraphModel dx="2000" dy="1200" grid="0" page="1" pageWidth="1920" pageHeight="1080" background="#F4FBF7" math="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4FBF7;strokeColor=none;;fontFamily=Helvetica;fontSize=24;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1920" height="1080" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1E7E5A;strokeColor=none;;fontFamily=Helvetica;fontSize=24;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1920" height="128" as="geometry"/></mxCell><mxCell id="c3" value="Questions" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#FFFFFF;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=40;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="64" y="24" width="1792" height="48" as="geometry"/></mxCell><mxCell id="c4" value="Anticipated questions and where the honest answer lives -- full detail in speaker notes." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#CDE9DC;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=25;" vertex="1" parent="1"><mxGeometry x="64" y="74" width="1792" height="34" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDE9DC;strokeWidth=3;shadow=1;;fontFamily=Helvetica;fontSize=24;" vertex="1" parent="1"><mxGeometry x="80" y="190" width="860" height="260" as="geometry"/></mxCell><mxCell id="c6" value="Q1" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#1E7E5A;strokeColor=none;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;;fontFamily=Helvetica;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="112" y="216" width="796" height="56" as="geometry"/></mxCell><mxCell id="c7" value="Is KV fp8 just an artificial amplifier you picked for drama?" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#14442F;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="112" y="286" width="796" height="70" as="geometry"/></mxCell><mxCell id="c8" value="No -- E4 one-factor-at-a-time attribution isolates KV dtype as the driver. Slide 8." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#5A7A6B;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=24;" vertex="1" parent="1"><mxGeometry x="112" y="362" width="796" height="84" as="geometry"/></mxCell><mxCell id="c9" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDE9DC;strokeWidth=3;shadow=1;;fontFamily=Helvetica;fontSize=24;" vertex="1" parent="1"><mxGeometry x="970" y="190" width="860" height="260" as="geometry"/></mxCell><mxCell id="c10" value="Q2" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#1E7E5A;strokeColor=none;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;;fontFamily=Helvetica;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1002" y="216" width="796" height="56" as="geometry"/></mxCell><mxCell id="c11" value="Is this just n=1?" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#14442F;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1002" y="286" width="796" height="70" as="geometry"/></mxCell><mxCell id="c12" value="3-seed collapse/rescue reproduction on H100. The miles-vs-slime concordance check itself is still n=1. Slides 6, 10, 11." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#5A7A6B;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=24;" vertex="1" parent="1"><mxGeometry x="1002" y="362" width="796" height="84" as="geometry"/></mxCell><mxCell id="c13" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDE9DC;strokeWidth=3;shadow=1;;fontFamily=Helvetica;fontSize=24;" vertex="1" parent="1"><mxGeometry x="80" y="480" width="860" height="260" as="geometry"/></mxCell><mxCell id="c14" value="Q3" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#1E7E5A;strokeColor=none;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;;fontFamily=Helvetica;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="112" y="506" width="796" height="56" as="geometry"/></mxCell><mxCell id="c15" value="miles is a fork of slime -- isn't agreement trivial?" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#14442F;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="112" y="576" width="796" height="70" as="geometry"/></mxCell><mxCell id="c16" value="Yes, fork-to-fork, not independent implementations -- said plainly. The concordance check itself is a single run; what was repeated on H100 is the collapse, not the concordance. Slide 6." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#5A7A6B;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=24;" vertex="1" parent="1"><mxGeometry x="112" y="652" width="796" height="84" as="geometry"/></mxCell><mxCell id="c17" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDE9DC;strokeWidth=3;shadow=1;;fontFamily=Helvetica;fontSize=24;" vertex="1" parent="1"><mxGeometry x="970" y="480" width="860" height="260" as="geometry"/></mxCell><mxCell id="c18" value="Q4" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#1E7E5A;strokeColor=none;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;;fontFamily=Helvetica;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1002" y="506" width="796" height="56" as="geometry"/></mxCell><mxCell id="c19" value="Does this reproduce on other hardware?" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#14442F;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1002" y="576" width="796" height="70" as="geometry"/></mxCell><mxCell id="c20" value="H100 (p5, EKS) reproduces the same qualitative divergence pattern as H200, not identical numbers. Slides 6, 9, 10." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#5A7A6B;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=24;" vertex="1" parent="1"><mxGeometry x="1002" y="652" width="796" height="84" as="geometry"/></mxCell><mxCell id="c21" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDE9DC;strokeWidth=3;shadow=1;;fontFamily=Helvetica;fontSize=24;" vertex="1" parent="1"><mxGeometry x="80" y="770" width="860" height="260" as="geometry"/></mxCell><mxCell id="c22" value="Q5" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#1E7E5A;strokeColor=none;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;;fontFamily=Helvetica;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="112" y="796" width="796" height="56" as="geometry"/></mxCell><mxCell id="c23" value="Where are the CPU/GIL numbers?" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#14442F;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="112" y="866" width="796" height="70" as="geometry"/></mxCell><mxCell id="c24" value="Nowhere -- honestly not measured, design only. Slide 3." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#5A7A6B;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=24;" vertex="1" parent="1"><mxGeometry x="112" y="942" width="796" height="84" as="geometry"/></mxCell><mxCell id="c25" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDE9DC;strokeWidth=3;shadow=1;;fontFamily=Helvetica;fontSize=24;" vertex="1" parent="1"><mxGeometry x="970" y="770" width="860" height="260" as="geometry"/></mxCell><mxCell id="c26" value="Q6" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#1E7E5A;strokeColor=none;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;;fontFamily=Helvetica;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1002" y="796" width="796" height="56" as="geometry"/></mxCell><mxCell id="c27" value="Why did the 30B MoE run fail?" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#14442F;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1002" y="866" width="796" height="70" as="geometry"/></mxCell><mxCell id="c28" value="Expert parallelism. Serving the checkpoint from SGLang alone reproduces it; EP=1 is clean at every TP. EP=1 cannot train though (108 GiB/rank). Slide 16." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#5A7A6B;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=24;" vertex="1" parent="1"><mxGeometry x="1002" y="942" width="796" height="84" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>