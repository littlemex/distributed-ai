c33" value="all 3 TIS runs SUCCEEDED end to end. Stability of the cure is not seed-dependent." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#14442F;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=24;" vertex="1" parent="1"><mxGeometry x="112" y="824" width="780" height="100" as="geometry"/></mxCell><mxCell id="c34" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C0392B;strokeWidth=4;shadow=1;;fontFamily=Helvetica;fontSize=24;" vertex="1" parent="1"><mxGeometry x="980" y="674" width="860" height="270" as="geometry"/></mxCell><mxCell id="c35" value="NO TIS: SEVERITY VARIES" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#C0392B;strokeColor=none;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;;fontFamily=Helvetica;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1012" y="698" width="560" height="52" as="geometry"/></mxCell><mxCell id="c36" value="peak mis_kl 2.85 / 12.59 / 13.67 -- collapse direction is consistent, severity is not." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#14442F;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=24;" vertex="1" parent="1"><mxGeometry x="1012" y="764" width="780" height="56" as="geometry"/></mxCell><mxCell id="c37" value="all 3 disease runs failed on the final checkpoint save (a known unpickling issue from the collapsed state; metrics fully captured before that)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#5A7A6B;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=24;" vertex="1" parent="1"><mxGeometry x="1012" y="824" width="780" height="100" as="geometry"/></mxCell><mxCell id="c38" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B7791F;strokeWidth=4;shadow=1;;fontFamily=Helvetica;fontSize=24;" vertex="1" parent="1"><mxGeometry x="80" y="968" width="1760" height="100" as="geometry"/></mxCell><mxCell id="c39" value="READ CAREFULLY: &quot;0.15&quot; above is the MAXIMUM reached, not the final value. Final TIS mis_kl across the 3 seeds is 0.071 / 0.094 / 0.133 -- a 1.9x spread. Direction is seed-independent; the exact number is not." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#C0392B;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="982" width="1680" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="09 tail and defenses" id="p09"><mxGraphModel dx="2000" dy="1200" grid="0" page="1" pageWidth="1920" pageHeight="1080" background="#F4FBF7" math="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4FBF7;strokeColor=none;;fontFamily=Helvetica;fontSize=24;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1920" height="1080" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1E7E5A;strokeColor=none;;fontFamily=Helvetica;fontSize=24;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1920" height="128" as="geometry"/></mxCell><mxCell id="c3" value="Why an average gap of 0.03 still kills the run" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#FFFFFF;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=40;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="64" y="24" width="1792" height="48" as="geometry"/></mxCell><mxCell id="c4" value="The mean is harmless. The tail is not." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#CDE9DC;strokeColor=none;fillColor=none;;fontFamily=Helvetica;fontSize=25;" vertex="1" parent="1"><mxGeometry x="64" y="74" width="1792" height="34" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDE9DC;strokeWidth=2;sh