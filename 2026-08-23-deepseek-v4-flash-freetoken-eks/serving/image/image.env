# FreeToken serving image coordinates. Sourced by build.sh and by scripts/deploy.sh (so the
# manifest and the build can never disagree about the tag).

# --- base image -------------------------------------------------------------------------------
# CUDA 13.0.x devel, NOT a newer 13.x. FreeToken JIT-compiles its kernels on first use and needs
# nvcc from a CUDA 13 toolkit, so a -devel image is mandatory (-runtime has no nvcc). The MINOR
# version is pinned deliberately: the CUDA minimum-driver table is
#   CUDA 13.0 -> >= 580.65.06   CUDA 13.1 -> >= 590.44.01
#   CUDA 13.2 -> >= 595.45.04   CUDA 13.3 -> >= 610.43.02
# and the EKS AL2023 NVIDIA AMI currently ships driver 580.178.04 (amazon-eks-ami v20260818).
# 580.178.04 satisfies 13.0 with room to spare but is BELOW the 13.1+ floors, so a
# 13.3-devel base would fail the driver requirement on the very AMI we run. Re-check this pairing
# before bumping either side.
BASE_IMAGE=nvidia/cuda:13.0.3-devel-ubuntu24.04

# --- FreeToken -------------------------------------------------------------------------------
# Pin a commit (not a branch) so the image is reproducible. FreeToken is young and its MoE
# offload paths move quickly.
FREETOKEN_REPO=https://github.com/FlashML-org/FreeToken.git
FREETOKEN_REF=main

# torch range per FreeToken's own install guidance.
# QUOTED deliberately: this file is `source`d, and unquoted `<2.12` is read as an input
# redirection ("No such file or directory: 2.12"), which silently leaves TORCH_SPEC truncated.
TORCH_SPEC='torch>=2.11,<2.12'

# --- destination -----------------------------------------------------------------------------
ECR_REPO=freetoken-serving
TAG=cuda1303-ft-main
