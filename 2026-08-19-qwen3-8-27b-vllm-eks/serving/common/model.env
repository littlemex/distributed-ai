# Shared model facts injected into BOTH engines at deploy time (single source of truth).
# deploy.sh sources this and injects the values so the vLLM values and the SGLang manifest
# cannot drift. Only these four (+ native context for YaRN) are shared; engine-specific tuning
# (quantization, speculative decoding, KV dtype) lives in each engine's own config.
MODEL_ID=Qwen/Qwen3.8-27B
SERVED_MODEL_NAME=Qwen/Qwen3.8-27B
NATIVE_CONTEXT=262144
YARN_FACTOR=4
MAX_CONTEXT=1048576
