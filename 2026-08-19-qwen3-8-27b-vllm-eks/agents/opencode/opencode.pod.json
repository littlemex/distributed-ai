{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "vllm-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "vLLM (Qwen3.8-27B on EKS)",
      "options": { "baseURL": "http://qwen-serving:8000/v1", "apiKey": "sk-noop" },
      "models": { "Qwen/Qwen3.8-27B": { "name": "Qwen3.8-27B", "limit": { "context": 32768, "output": 2048 } } }
    }
  },
  "mcp": {
    "bedrock-websearch": {
      "type": "local",
      "command": ["python3", "/opt/tools/bedrock_websearch.py", "--mcp"],
      "environment": { "AWS_REGION": "us-east-1", "BEDROCK_WS_REGION": "us-east-1" }
    }
  }
}
