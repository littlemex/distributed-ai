# Copy to `agents.env` next to agents.sh and fill these in. Nothing else is needed.
# Prereqs on your Mac: kubectl, aws CLI, curl, python3 (+ active AWS credentials). Keyless: uses kubectl exec.

# --- AWS / cluster ---
# AWS_PROFILE=my-profile  # optional; leave this line commented out to use your default
                         # credentials. Setting it to nothing is not the same thing: the AWS
                         # CLI then looks for a profile named "" and fails, and it reports
                         # that as missing credentials. This script unsets an empty one for
                         # you, but anything else you paste the value into will not.
CLUSTER_NAME=            # optional
REGION=ap-northeast-1
KUBE_CONTEXT=            # optional; default = current kubeconfig context
NAMESPACE=qwen


# --- OpenClaw (browser) ---
OPENCLAW_SVC=openclaw
OPENCLAW_PORT=18789
OPENCLAW_TOKEN=qwen-demo-token   # gateway token (matches the openclaw-gateway Secret)

# --- pod/deployment names (defaults match this project's manifests) ---
OPENCODE_DEPLOY=opencode
HERMES_DEPLOY=hermes
QWENCODE_DEPLOY=qwen-code
