# Copy to `agents.env` next to agents.sh and fill these in. Nothing else is needed.
# Prereqs on your Mac: kubectl, aws CLI, curl, python3 (+ active AWS credentials). Keyless: uses kubectl exec.

# --- AWS / cluster ---
AWS_PROFILE=              # optional; leave empty to use the default profile
CLUSTER_NAME=distai-eks
REGION=ap-northeast-1
KUBE_CONTEXT=distai-tokyo # local kubeconfig context alias agents.sh will create
NAMESPACE=distai


# --- OpenClaw (browser) ---
OPENCLAW_SVC=openclaw
OPENCLAW_PORT=18789
OPENCLAW_TOKEN=qwen-demo-token   # gateway token (matches the openclaw-gateway Secret)

# --- pod/deployment names (defaults match this project's manifests) ---
OPENCODE_DEPLOY=opencode
HERMES_DEPLOY=hermes
