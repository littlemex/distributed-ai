<mxfile host="app.diagrams.net">
  <diagram id="verl-comm-stack" name="図3 verl スタック階層">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2700" pageHeight="1550" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title1" value="図3: verl が使う通信プリミティブのスタック階層 (AWS EFA 前提)" style="text;html=1;align=left;fontSize=26;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="1700" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="角丸の実線ボックス = verl が直接 / rollout backend 経由で使うもの。六角形の破線 = verl は使わない (slime 側にあり・参考)。" style="text;html=1;align=left;fontSize=20;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="60" y="76" width="2100" height="30" as="geometry"/></mxCell>

        <!-- レイヤ帯 -->
        <mxCell id="lay4" value="" style="rounded=0;fillColor=#f5f5f5;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="2580" height="150" as="geometry"/></mxCell>
        <mxCell id="lay4lab" value="L4  アプリ / フレームワーク" style="text;html=1;align=left;verticalAlign=top;fontColor=#999999;fontSize=20;" vertex="1" parent="1"><mxGeometry x="72" y="166" width="500" height="30" as="geometry"/></mxCell>
        <mxCell id="lay3" value="" style="rounded=0;fillColor=#e8f5e9;strokeColor=#a5d6a7;" vertex="1" parent="1"><mxGeometry x="60" y="340" width="2580" height="190" as="geometry"/></mxCell>
        <mxCell id="lay3lab" value="L3  通信抽象 / collective ライブラリ" style="text;html=1;align=left;verticalAlign=top;fontColor=#66996a;fontSize=20;" vertex="1" parent="1"><mxGeometry x="72" y="346" width="600" height="30" as="geometry"/></mxCell>
        <mxCell id="lay2" value="" style="rounded=0;fillColor=#fff3e0;strokeColor=#ffcc80;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="2580" height="190" as="geometry"/></mxCell>
        <mxCell id="lay2lab" value="L2  トランスポート / CheckpointEngine backend" style="text;html=1;align=left;verticalAlign=top;fontColor=#b3854a;fontSize=20;" vertex="1" parent="1"><mxGeometry x="72" y="566" width="700" height="30" as="geometry"/></mxCell>
        <mxCell id="lay1" value="" style="rounded=0;fillColor=#fde8ec;strokeColor=#f4a6b6;" vertex="1" parent="1"><mxGeometry x="60" y="780" width="2580" height="170" as="geometry"/></mxCell>
        <mxCell id="lay1lab" value="L1  カーネルドライバ / GPU メモリ直結" style="text;html=1;align=left;verticalAlign=top;fontColor=#b3637a;fontSize=20;" vertex="1" parent="1"><mxGeometry x="72" y="786" width="640" height="30" as="geometry"/></mxCell>
        <mxCell id="lay0" value="" style="rounded=0;fillColor=#eeeeee;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="60" y="980" width="2580" height="160" as="geometry"/></mxCell>
        <mxCell id="lay0lab" value="L0  ハードウェア" style="text;html=1;align=left;verticalAlign=top;fontColor=#888888;fontSize=20;" vertex="1" parent="1"><mxGeometry x="72" y="986" width="400" height="30" as="geometry"/></mxCell>

        <!-- L4 -->
        <mxCell id="vllm" value="vLLM / SGLang / TRT-LLM&#10;(rollout 推論)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9e9e9e;fontSize=20;" vertex="1" parent="1"><mxGeometry x="240" y="200" width="420" height="80" as="geometry"/></mxCell>
        <mxCell id="trainer" value="verl PPOTrainer / Megatron・FSDP&#10;(GRPO/PPO trainer)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9e9e9e;fontSize=20;" vertex="1" parent="1"><mxGeometry x="1860" y="200" width="460" height="80" as="geometry"/></mxCell>

        <!-- L3: verl が使う (角丸実線) -->
        <mxCell id="dataproto" value="DataProto / Ray&#10;(rollout データ収集)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#4caf50;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="160" y="385" width="360" height="100" as="geometry"/></mxCell>
        <mxCell id="ckptmgr" value="CheckpointEngineRegistry&#10;(weight sync pluggable 抽象)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#4caf50;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="385" width="440" height="100" as="geometry"/></mxCell>
        <mxCell id="nccl" value="NCCL&#10;(gradient AllReduce /&#10;weight sync broadcast)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#4caf50;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1860" y="385" width="460" height="100" as="geometry"/></mxCell>
        <!-- verl が使わない (六角形破線) -->
        <mxCell id="gloo" value="Gloo 専用 barrier&#10;(verl 不使用: torch.barrier+ray.get)" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#aaaaaa;dashed=1;fontSize=18;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="1080" y="390" width="320" height="90" as="geometry"/></mxCell>
        <mxCell id="nixlroll" value="NIXL rollout transport&#10;(verl 不使用 / slime 側にあり)" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#aaaaaa;dashed=1;fontSize=18;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="1430" y="390" width="340" height="90" as="geometry"/></mxCell>

        <!-- L2: CheckpointEngine backend (verl が使う、角丸実線) -->
        <mxCell id="be_ipc" value="naive (colocated)&#10;ZMQ + CUDA IPC&#10;BucketedWeightSender 512MB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#fb8c00;fontSize=18;" vertex="1" parent="1"><mxGeometry x="120" y="600" width="360" height="100" as="geometry"/></mxCell>
        <mxCell id="be_nixl" value="nixl&#10;UCX + IB RDMA ring&#10;NIXLCheckpointEngine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#fb8c00;fontSize=18;" vertex="1" parent="1"><mxGeometry x="500" y="600" width="340" height="100" as="geometry"/></mxCell>
        <mxCell id="be_mooncake" value="mooncake / kimi&#10;Mooncake TransferEngine&#10;P2P RDMA chain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#fb8c00;fontSize=18;" vertex="1" parent="1"><mxGeometry x="860" y="600" width="340" height="100" as="geometry"/></mxCell>
        <mxCell id="awsofi" value="aws-ofi-nccl&#10;(NCCL → EFA アダプタ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#fb8c00;fontSize=20;" vertex="1" parent="1"><mxGeometry x="1860" y="600" width="460" height="100" as="geometry"/></mxCell>
        <mxCell id="libfabric" value="libfabric (+ EFA provider) / UCX" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#fb8c00;fontSize=20;" vertex="1" parent="1"><mxGeometry x="1280" y="600" width="420" height="100" as="geometry"/></mxCell>
        <!-- verl が使わない L2 (delta) -->
        <mxCell id="be_delta" value="delta sync&#10;(verl 未マージ PR#6794 / slime 側にあり)" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#aaaaaa;dashed=1;fontSize=16;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="2360" y="605" width="280" height="90" as="geometry"/></mxCell>

        <!-- L1 -->
        <mxCell id="efako" value="efa.ko&#10;(EFA ドライバ)" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f8bbd0;strokeColor=#e91e63;fontSize=20;" vertex="1" parent="1"><mxGeometry x="900" y="810" width="340" height="100" as="geometry"/></mxCell>
        <mxCell id="gpudirect" value="GPUDirect RDMA&#10;(nv_peer_mem)" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f8bbd0;strokeColor=#e91e63;fontSize=20;" vertex="1" parent="1"><mxGeometry x="1600" y="810" width="360" height="100" as="geometry"/></mxCell>

        <!-- L0 -->
        <mxCell id="efanic" value="AWS EFA NIC (SRD)" style="shape=trapezoid;perimeter=trapezoidPerimeter;whiteSpace=wrap;html=1;fillColor=#e0e0e0;strokeColor=#757575;fontSize=20;" vertex="1" parent="1"><mxGeometry x="900" y="1010" width="340" height="100" as="geometry"/></mxCell>
        <mxCell id="gpu" value="NVIDIA GPU (VRAM)" style="shape=trapezoid;perimeter=trapezoidPerimeter;whiteSpace=wrap;html=1;fillColor=#e0e0e0;strokeColor=#757575;fontSize=20;" vertex="1" parent="1"><mxGeometry x="1600" y="1010" width="360" height="100" as="geometry"/></mxCell>

        <!-- エッジ -->
        <mxCell id="e_sg_dp" style="endArrow=block;html=1;strokeColor=#4caf50;strokeWidth=2;" edge="1" parent="1" source="vllm" target="dataproto"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_tr_nccl" style="endArrow=block;html=1;strokeColor=#1f4f7a;strokeWidth=2;" edge="1" parent="1" source="trainer" target="nccl"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_tr_ckpt" value="weight sync" style="endArrow=block;html=1;strokeColor=#4caf50;strokeWidth=2;fontSize=18;fontColor=#2d7a3a;" edge="1" parent="1" source="trainer" target="ckptmgr"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_ck_ipc" style="endArrow=block;html=1;strokeColor=#fb8c00;strokeWidth=2;exitX=0.2;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="ckptmgr" target="be_ipc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_ck_nixl" style="endArrow=block;html=1;strokeColor=#fb8c00;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="ckptmgr" target="be_nixl"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_ck_mc" style="endArrow=block;html=1;strokeColor=#fb8c00;strokeWidth=2;exitX=0.8;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="ckptmgr" target="be_mooncake"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_ck_nccl" style="endArrow=block;html=1;strokeColor=#fb8c00;strokeWidth=2;dashed=1;" edge="1" parent="1" source="ckptmgr" target="nccl"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_nccl_ofi" style="endArrow=block;html=1;strokeColor=#1f4f7a;strokeWidth=2;" edge="1" parent="1" source="nccl" target="awsofi"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_nixl_lf" value="UCX" style="endArrow=block;html=1;strokeColor=#fb8c00;strokeWidth=2;fontSize=18;fontColor=#b3854a;" edge="1" parent="1" source="be_nixl" target="libfabric"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_mc_lf" style="endArrow=block;html=1;strokeColor=#fb8c00;strokeWidth=2;" edge="1" parent="1" source="be_mooncake" target="libfabric"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_ofi_lf" style="endArrow=block;html=1;strokeColor=#fb8c00;strokeWidth=2;" edge="1" parent="1" source="awsofi" target="libfabric"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_lf_efa" style="endArrow=block;html=1;strokeColor=#fb8c00;strokeWidth=2;" edge="1" parent="1" source="libfabric" target="efako"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_lf_gdr" value="GPU mem 転送時" style="endArrow=open;html=1;dashed=1;strokeColor=#f4a6b6;strokeWidth=2;fontSize=18;fontColor=#b3637a;" edge="1" parent="1" source="libfabric" target="gpudirect"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_ipc_gpu" value="CUDA IPC (ノード内)" style="endArrow=open;html=1;dashed=1;strokeColor=#f4a6b6;strokeWidth=2;fontSize=18;fontColor=#b3637a;" edge="1" parent="1" source="be_ipc" target="gpudirect"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_efa_nic" style="endArrow=block;html=1;strokeColor=#e91e63;strokeWidth=2;" edge="1" parent="1" source="efako" target="efanic"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_gdr_gpu" style="endArrow=block;html=1;strokeColor=#e91e63;strokeWidth=2;" edge="1" parent="1" source="gpudirect" target="gpu"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- 凡例 -->
        <mxCell id="leg" value="凡例" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="1170" width="2580" height="130" as="geometry"/></mxCell>
        <mxCell id="legtxt" value="角丸の実線 = verl が使う。六角形の破線グレー = verl は使わない (slime 側にあり・参考)。&#10;verl 固有: CheckpointEngineRegistry による pluggable 抽象 (naive/nccl/nixl/mooncake/kimi/hccl)、NIXL・Mooncake を weight sync 本体に使用。&#10;slime 側にあって verl にないもの: delta sync (本番) / NIXL rollout transport / Gloo 専用 barrier。" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="80" y="1205" width="2540" height="90" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="verl-rl-flow" name="図4 verl RL通信フェーズ">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2700" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="図4: verl の GRPO/PPO 1 イテレーションのノード間通信フェーズ (AWS EFA 前提)" style="text;html=1;align=left;fontSize=26;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="1900" height="40" as="geometry"/></mxCell>
        <mxCell id="leg" value="赤 = ノード間 EFA を流れる通信 (gradient 同期・weight sync)。緑 = rollout 関連。灰 = ローカル / 制御のみ。&#10;slime との主な違い: (1) advantage 正規化がローカル CPU のみ (NCCL なし)。(2) KV cache PD 分離フェーズあり。(3) weight sync backend が pluggable。" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="2580" height="70" as="geometry"/></mxCell>
        <mxCell id="trainbox" value="" style="rounded=1;fillColor=#eaf2fb;strokeColor=#4a78b5;" vertex="1" parent="1"><mxGeometry x="60" y="180" width="980" height="1000" as="geometry"/></mxCell>
        <mxCell id="trainlab" value="Train cluster  (verl: FSDP / Megatron, TP・PP・DP・EP・CP)" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#1f4f7a;" vertex="1" parent="1"><mxGeometry x="80" y="190" width="940" height="30" as="geometry"/></mxCell>
        <mxCell id="rollbox" value="" style="rounded=1;fillColor=#eaf7ec;strokeColor=#4caf50;" vertex="1" parent="1"><mxGeometry x="1760" y="180" width="880" height="1000" as="geometry"/></mxCell>
        <mxCell id="rolllab" value="Rollout cluster  (vLLM / SGLang / TRT-LLM)" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#2d7a3a;" vertex="1" parent="1"><mxGeometry x="1780" y="190" width="840" height="30" as="geometry"/></mxCell>
        <mxCell id="efaband" value="" style="rounded=0;fillColor=#fff3e0;strokeColor=#fb8c00;" vertex="1" parent="1"><mxGeometry x="1080" y="180" width="640" height="1000" as="geometry"/></mxCell>
        <mxCell id="efalab" value="ノード間ファブリック&#10;AWS EFA (SRD)" style="text;html=1;align=center;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#b3854a;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="1100" y="195" width="600" height="60" as="geometry"/></mxCell>

        <mxCell id="t_actor" value="Actor (学習中の重み)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a78b5;fontSize=20;" vertex="1" parent="1"><mxGeometry x="100" y="250" width="420" height="70" as="geometry"/></mxCell>
        <mxCell id="t_ref" value="Reference / Old policy&#10;(log-prob, Ray RPC dispatch)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a78b5;fontSize=20;" vertex="1" parent="1"><mxGeometry x="560" y="250" width="420" height="70" as="geometry"/></mxCell>
        <mxCell id="t_intra" value="" style="rounded=1;fillColor=#dbe8f7;strokeColor=#4a78b5;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="100" y="360" width="880" height="320" as="geometry"/></mxCell>
        <mxCell id="t_intralab" value="Train 内部分散通信 (フェーズ 5)" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontStyle=1;fontColor=#1f4f7a;" vertex="1" parent="1"><mxGeometry x="116" y="370" width="600" height="30" as="geometry"/></mxCell>
        <mxCell id="t_tp" value="TP AllReduce / AllGather&#10;Ulysses SP all2all (ノード内)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a78b5;fontSize=20;" vertex="1" parent="1"><mxGeometry x="120" y="410" width="400" height="80" as="geometry"/></mxCell>
        <mxCell id="t_pp" value="PP P2P send/recv&#10;(activation・gradient)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a78b5;fontSize=20;" vertex="1" parent="1"><mxGeometry x="560" y="410" width="400" height="80" as="geometry"/></mxCell>
        <mxCell id="t_dp" value="DP gradient 同期&#10;FSDP reduce-scatter / Megatron AllReduce&#10;★ ノード間 EFA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde7ec;strokeColor=#e91e63;fontSize=20;" vertex="1" parent="1"><mxGeometry x="120" y="520" width="400" height="120" as="geometry"/></mxCell>
        <mxCell id="t_ep" value="MoE EP all-to-all&#10;(Megatron core alltoall)&#10;ノード跨ぎなら EFA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a78b5;fontSize=20;" vertex="1" parent="1"><mxGeometry x="560" y="520" width="400" height="120" as="geometry"/></mxCell>
        <mxCell id="t_rew" value="フェーズ 2-3: Reward (ローカル ProcessPool)&#10;Advantage 正規化 ★ローカル CPU のみ (NCCL なし)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=20;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="100" y="710" width="880" height="80" as="geometry"/></mxCell>
        <mxCell id="t_ws" value="フェーズ 6: Weight Sync 送信&#10;CheckpointEngine backend を選択して配布" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde7ec;strokeColor=#e91e63;fontSize=20;fontStyle=1;fontColor=#b3214f;" vertex="1" parent="1"><mxGeometry x="100" y="830" width="880" height="90" as="geometry"/></mxCell>

        <mxCell id="r_engine" value="Rollout engine (vLLM/SGLang)&#10;sequences / tokens 生成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4caf50;fontSize=20;" vertex="1" parent="1"><mxGeometry x="1800" y="250" width="420" height="80" as="geometry"/></mxCell>
        <mxCell id="r_pd" value="フェーズ 1b: KV cache PD 分離 (verl 独自)&#10;prefill→decode の KV 転送&#10;SGLang transfer_backend (NIXL/Mooncake)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde7ec;strokeColor=#e91e63;fontSize=20;fontColor=#b3214f;" vertex="1" parent="1"><mxGeometry x="1800" y="390" width="420" height="120" as="geometry"/></mxCell>
        <mxCell id="r_ws" value="フェーズ 6: Weight Sync 受信&#10;重みを engine に反映" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde7ec;strokeColor=#e91e63;fontSize=20;fontStyle=1;fontColor=#b3214f;" vertex="1" parent="1"><mxGeometry x="1800" y="830" width="420" height="90" as="geometry"/></mxCell>

        <mxCell id="p2" edge="1" parent="1" source="r_engine" target="t_ref" value="フェーズ 1: rollout データ収集&#10;DataProto / DataProtoFuture (Ray object store)&#10;★ NIXL rollout transport なし (Ray のみ)" style="endArrow=block;html=1;strokeColor=#4caf50;strokeWidth=3;fontSize=20;fontColor=#2d7a3a;verticalAlign=top;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p6" edge="1" parent="1" source="t_ws" target="r_ws" value="フェーズ 6&#10;Weight Sync" style="endArrow=block;html=1;strokeColor=#e91e63;strokeWidth=4;fontSize=22;fontColor=#b3214f;fontStyle=1;"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="wsbox" value="" style="rounded=1;fillColor=#fdf0f3;strokeColor=#e91e63;dashed=1;" vertex="1" parent="1"><mxGeometry x="60" y="1220" width="2580" height="240" as="geometry"/></mxCell>
        <mxCell id="wslab" value="verl の Weight Sync (フェーズ 6): CheckpointEngine backend を config で選択" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#b3214f;" vertex="1" parent="1"><mxGeometry x="80" y="1230" width="1600" height="30" as="geometry"/></mxCell>
