# ============================================================================
# Weight Sync ベンチ A1: Qwen3-4B / colocated (CUDA IPC)
# ============================================================================
# apple-to-apple マトリクス (方式 × 規模) のセル A1。
# 比較の対照:
#   - A1 (本ファイル) vs A2(4b-disaggregated): モデル・engine数・mem-fraction を
#     揃え、★方式だけ★ を変える → CUDA IPC vs NCCL/EFA の純粋比較
# 揃える固定条件 (3セル共通、BENCH_COMMON 参照):
#   engine 数 = 4, SGLANG_MEM_FRACTION = ${BENCH_MEM_FRACTION}, 訓練ハイパラ一式
# このセルで変える点: COLOCATE=true (CUDA IPC), モデル=4B
# ----------------------------------------------------------------------------
# colocated で engine 4 にする: rollout 16 GPU / ROLLOUT_GPUS_PER_ENGINE=4 = 4 engine (TP4)
#   ※ 旧 env_vars.myuser は ROLLOUT_GPUS_PER_ENGINE=8 (2 engine) だった。
#     A2(disaggregated) も 4 engine なので、engine 数交絡を排除するため 4 に揃える。
# ============================================================================

export HF_TOKEN="${HF_TOKEN:-}"

# ----- Model: Qwen3-4B -----
export MODEL_NAME="Qwen/Qwen3-4B"
export MODEL_LOCAL="/fsx/myuser/slime/models/Qwen3-4B"
export MODEL_DIST="/fsx/myuser/slime/models/Qwen3-4B_torch_dist"
export MODEL_SCRIPT="qwen3-4B.sh"

# ----- 方式: colocated (CUDA IPC, UpdateWeightFromTensor) -----
export COLOCATE="true"
export TP_SIZE=1
export PP_SIZE=1
export CP_SIZE=1
export EP_SIZE=1
# colocated: train と rollout が同一 16 GPU を共有。engine 数を A2 と揃えて 4 にする。
export ROLLOUT_NUM_GPUS=16
export ROLLOUT_GPUS_PER_ENGINE=4   # 16 / 4 = 4 engine (TP4) ← A2 と engine 数を揃える
export ACTOR_NUM_NODES=2
export ACTOR_GPUS_PER_NODE=8
export MAX_TOKENS_PER_GPU=8192
export ROLLOUT_MAX_RESPONSE_LEN=8192
export CKPT_SUBDIR="bench-a1-4b-colocated"

# ----- 訓練ハイパラ (3セル共通・固定) -----
export PROMPT_DATA="/fsx/myuser/slime/data/dapo-math-17k/dapo-math-17k.jsonl"
export EVAL_DATA="/fsx/myuser/slime/data/aime-2024/aime-2024.jsonl"
export CHECKPOINT_DIR="/fsx/myuser/slime/checkpoints"
export SAVE_INTERVAL=1000          # ベンチ中は保存しない (weight sync 計測に集中)
export NUM_ROLLOUT=10              # weight sync を数回観測できれば十分
export ROLLOUT_BATCH_SIZE=16
export N_SAMPLES_PER_PROMPT=8
export GLOBAL_BATCH_SIZE=128
export NUM_STEPS_PER_ROLLOUT=1
export LEARNING_RATE="1e-6"
export ROLLOUT_TEMPERATURE=1.0
export RM_TYPE="deepscaler"
export RM_URL=""

# ----- B300 固有 delta (壁の対処、3セル共通) -----
export SGLANG_LOG_LEVEL="info"                              # 壁2: uvicorn 有効値
export SGLANG_EXTRA_ARGS="--sglang-cuda-graph-max-bs 8"     # 壁3: B300 大HBM capture 抑制
export TRAIN_EXTRA_ARGS="--no-offload-train --no-offload-rollout"  # 壁5
export PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True"   # 壁8
# ----- ★apple-to-apple の要: mem-fraction を A2/B1 と揃える★ -----
# colocated は train と GPU 共有のため高すぎると OOM する (旧実験で 0.8 OOM → 0.4)。
# 3セル共通値を BENCH_MEM_FRACTION で外部注入 (run_bench.sh が設定)。
# 既定 0.5 は「colocated が OOM せず、disaggregated にも適用できる」共通候補。
export SGLANG_MEM_FRACTION="${BENCH_MEM_FRACTION:-0.5}"
