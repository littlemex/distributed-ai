# ============================================================================
# Weight Sync ベンチ A2: Qwen3-4B / disaggregated (NCCL/EFA)
# ============================================================================
# apple-to-apple マトリクス (方式 × 規模) のセル A2。
# 比較の対照:
#   - A1(4b-colocated) vs A2 (本ファイル): モデル・engine数・mem-fraction を揃え、
#     ★方式だけ★ を変える → CUDA IPC vs NCCL/EFA の純粋比較 (登壇の核心)
#   - A2 vs B1(30b-moe-disaggregated): 方式・engine数を揃え、★モデル規模だけ★ を
#     変える → weight sync の転送量スケーリング (4B → 30B MoE)
# このセルで変える点: COLOCATE=false (NCCL/EFA), モデル=4B
# ----------------------------------------------------------------------------
# disaggregated GPU 配分: actor 8 (node1) + rollout 8 (node2) = 16
#   rollout 8 GPU / ROLLOUT_GPUS_PER_ENGINE=2 = 4 engine (TP2) ← A1 と engine 数を揃える
# ============================================================================

export HF_TOKEN="${HF_TOKEN:-}"

# ----- Model: Qwen3-4B (A1 と同一) -----
export MODEL_NAME="Qwen/Qwen3-4B"
export MODEL_LOCAL="/fsx/myuser/slime/models/Qwen3-4B"
export MODEL_DIST="/fsx/myuser/slime/models/Qwen3-4B_torch_dist"
export MODEL_SCRIPT="qwen3-4B.sh"

# ----- 方式: disaggregated (NCCL/EFA, UpdateWeightFromDistributed) -----
export COLOCATE="false"
export TP_SIZE=1
export PP_SIZE=1
export CP_SIZE=1
export EP_SIZE=1
export ROLLOUT_NUM_GPUS=8
export ROLLOUT_GPUS_PER_ENGINE=2   # 8 / 2 = 4 engine (TP2) ← A1 と engine 数を揃える
export ACTOR_NUM_NODES=1           # actor 8 GPU (rollout と別ノード)
export ACTOR_GPUS_PER_NODE=8
export MAX_TOKENS_PER_GPU=8192
export ROLLOUT_MAX_RESPONSE_LEN=8192
export CKPT_SUBDIR="bench-a2-4b-disaggregated"

# ----- 訓練ハイパラ (3セル共通・固定) -----
export PROMPT_DATA="/fsx/myuser/slime/data/dapo-math-17k/dapo-math-17k.jsonl"
export EVAL_DATA="/fsx/myuser/slime/data/aime-2024/aime-2024.jsonl"
export CHECKPOINT_DIR="/fsx/myuser/slime/checkpoints"
export SAVE_INTERVAL=1000
export NUM_ROLLOUT=10
export ROLLOUT_BATCH_SIZE=16
export N_SAMPLES_PER_PROMPT=8
export GLOBAL_BATCH_SIZE=128
export NUM_STEPS_PER_ROLLOUT=1
export LEARNING_RATE="1e-6"
export ROLLOUT_TEMPERATURE=1.0
export RM_TYPE="deepscaler"
export RM_URL=""

# ----- B300 固有 delta (壁の対処、3セル共通) -----
export SGLANG_LOG_LEVEL="info"
export SGLANG_EXTRA_ARGS="--sglang-cuda-graph-max-bs 8"
export TRAIN_EXTRA_ARGS="--no-offload-train --no-offload-rollout"
export PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True"
# ----- ★apple-to-apple の要: mem-fraction を A1/B1 と揃える★ -----
# disaggregated は rollout 専有なので本来 0.8 でも可だが、A1(colocated) と揃えるため
# 共通値 BENCH_MEM_FRACTION を使う (方式比較で mem-fraction 交絡を排除)。
export SGLANG_MEM_FRACTION="${BENCH_MEM_FRACTION:-0.5}"
