<mxfile host="app.diagrams.net">
  <diagram id="comm-primitives" name="図1 通信プリミティブ階層">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2700" pageHeight="1550" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title1" value="図1: slime が使う通信プリミティブのスタック階層 (AWS EFA 前提)" style="text;html=1;align=left;fontSize=26;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="1700" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="角丸の実線ボックス = slime が直接 / SGLang 経由で使うもの。六角形の破線 = slime は使わない (別環境・参考)。" style="text;html=1;align=left;fontSize=20;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="60" y="76" width="2000" height="30" as="geometry"/></mxCell>

        <!-- レイヤ帯 -->
        <mxCell id="lay4" value="" style="rounded=0;fillColor=#f5f5f5;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="2580" height="150" as="geometry"/></mxCell>
        <mxCell id="lay4lab" value="L4  アプリ / フレームワーク" style="text;html=1;align=left;verticalAlign=top;fontColor=#999999;fontSize=20;" vertex="1" parent="1"><mxGeometry x="72" y="166" width="500" height="30" as="geometry"/></mxCell>
        <mxCell id="lay3" value="" style="rounded=0;fillColor=#e8f5e9;strokeColor=#a5d6a7;" vertex="1" parent="1"><mxGeometry x="60" y="340" width="2580" height="190" as="geometry"/></mxCell>
        <mxCell id="lay3lab" value="L3  通信抽象 / collective ライブラリ" style="text;html=1;align=left;verticalAlign=top;fontColor=#66996a;fontSize=20;" vertex="1" parent="1"><mxGeometry x="72" y="346" width="600" height="30" as="geometry"/></mxCell>
        <mxCell id="lay2" value="" style="rounded=0;fillColor=#fff3e0;strokeColor=#ffcc80;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="2580" height="180" as="geometry"/></mxCell>
        <mxCell id="lay2lab" value="L2  トランスポート / NIXL バックエンド" style="text;html=1;align=left;verticalAlign=top;fontColor=#b3854a;fontSize=20;" vertex="1" parent="1"><mxGeometry x="72" y="566" width="640" height="30" as="geometry"/></mxCell>
        <mxCell id="lay1" value="" style="rounded=0;fillColor=#fde8ec;strokeColor=#f4a6b6;" vertex="1" parent="1"><mxGeometry x="60" y="770" width="2580" height="170" as="geometry"/></mxCell>
        <mxCell id="lay1lab" value="L1  カーネルドライバ / GPU メモリ直結" style="text;html=1;align=left;verticalAlign=top;fontColor=#b3637a;fontSize=20;" vertex="1" parent="1"><mxGeometry x="72" y="776" width="640" height="30" as="geometry"/></mxCell>
        <mxCell id="lay0" value="" style="rounded=0;fillColor=#eeeeee;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="60" y="970" width="2580" height="160" as="geometry"/></mxCell>
        <mxCell id="lay0lab" value="L0  ハードウェア" style="text;html=1;align=left;verticalAlign=top;fontColor=#888888;fontSize=20;" vertex="1" parent="1"><mxGeometry x="72" y="976" width="400" height="30" as="geometry"/></mxCell>

        <!-- L4 アプリ -->
        <mxCell id="vllm" value="SGLang&#10;(rollout 推論)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9e9e9e;fontSize=20;" vertex="1" parent="1"><mxGeometry x="260" y="210" width="340" height="80" as="geometry"/></mxCell>
        <mxCell id="trainer" value="slime / Megatron&#10;(GRPO trainer)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9e9e9e;fontSize=20;" vertex="1" parent="1"><mxGeometry x="1900" y="210" width="380" height="80" as="geometry"/></mxCell>

        <!-- L3 通信抽象: slime が使うもの (角丸実線) -->
        <mxCell id="ray" value="Ray object store&#10;(rollout データ収集)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#4caf50;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="385" width="340" height="100" as="geometry"/></mxCell>
        <mxCell id="nixl" value="NIXL&#10;(SGLang 経由 / 任意)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#4caf50;fontSize=20;" vertex="1" parent="1"><mxGeometry x="500" y="385" width="320" height="100" as="geometry"/></mxCell>
        <mxCell id="gloo" value="Gloo&#10;(gather / barrier, CPU)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#4caf50;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="860" y="385" width="340" height="100" as="geometry"/></mxCell>
        <mxCell id="nccl" value="NCCL&#10;(weight sync broadcast /&#10;gradient AllReduce)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#4caf50;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1900" y="385" width="420" height="100" as="geometry"/></mxCell>
        <!-- slime が使わないもの (六角形破線) -->
        <mxCell id="nvshmem" value="NVSHMEM&#10;(slime 不使用)" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#aaaaaa;dashed=1;fontSize=18;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="1260" y="390" width="280" height="90" as="geometry"/></mxCell>
        <mxCell id="deepep" value="DeepEP&#10;(slime core 未統合)" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#aaaaaa;dashed=1;fontSize=18;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="1570" y="390" width="280" height="90" as="geometry"/></mxCell>

        <!-- L2: slime が使うもの -->
        <mxCell id="ucx" value="UCX&#10;(NIXL の SRD backend)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#fb8c00;fontSize=20;" vertex="1" parent="1"><mxGeometry x="500" y="600" width="320" height="100" as="geometry"/></mxCell>
        <mxCell id="awsofi" value="aws-ofi-nccl&#10;(NCCL → EFA アダプタ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#fb8c00;fontSize=20;" vertex="1" parent="1"><mxGeometry x="1900" y="600" width="420" height="100" as="geometry"/></mxCell>
        <mxCell id="libfabric" value="libfabric&#10;(+ EFA provider)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#fb8c00;fontSize=20;" vertex="1" parent="1"><mxGeometry x="1180" y="600" width="340" height="100" as="geometry"/></mxCell>
        <!-- slime が使わない L2 (参考) -->
        <mxCell id="uccl" value="UCCL&#10;(NIXL backend, slime 不使用)" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#aaaaaa;dashed=1;fontSize=18;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="860" y="605" width="280" height="90" as="geometry"/></mxCell>

        <!-- L1 -->
        <mxCell id="efako" value="efa.ko&#10;(EFA ドライバ)" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f8bbd0;strokeColor=#e91e63;fontSize=20;" vertex="1" parent="1"><mxGeometry x="900" y="800" width="340" height="100" as="geometry"/></mxCell>
        <mxCell id="gpudirect" value="GPUDirect RDMA&#10;(nv_peer_mem)" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f8bbd0;strokeColor=#e91e63;fontSize=20;" vertex="1" parent="1"><mxGeometry x="1600" y="800" width="360" height="100" as="geometry"/></mxCell>

        <!-- L0 -->
        <mxCell id="efanic" value="AWS EFA NIC (SRD)" style="shape=trapezoid;perimeter=trapezoidPerimeter;whiteSpace=wrap;html=1;fillColor=#e0e0e0;strokeColor=#757575;fontSize=20;" vertex="1" parent="1"><mxGeometry x="900" y="1000" width="340" height="100" as="geometry"/></mxCell>
        <mxCell id="gpu" value="NVIDIA GPU (VRAM)" style="shape=trapezoid;perimeter=trapezoidPerimeter;whiteSpace=wrap;html=1;fillColor=#e0e0e0;strokeColor=#757575;fontSize=20;" vertex="1" parent="1"><mxGeometry x="1600" y="1000" width="360" height="100" as="geometry"/></mxCell>

        <!-- エッジ: アプリ → L3 -->
        <mxCell id="e_sg_ray" style="endArrow=block;html=1;strokeColor=#4caf50;strokeWidth=2;" edge="1" parent="1" source="vllm" target="ray"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_sg_nixl" value="rollout data&#10;(任意)" style="endArrow=block;html=1;strokeColor=#4caf50;strokeWidth=2;fontSize=18;fontColor=#2d7a3a;" edge="1" parent="1" source="vllm" target="nixl"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_tr_nccl" style="endArrow=block;html=1;strokeColor=#1f4f7a;strokeWidth=2;" edge="1" parent="1" source="trainer" target="nccl"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_tr_gloo" value="gather / barrier" style="endArrow=block;html=1;strokeColor=#4caf50;strokeWidth=2;fontSize=18;fontColor=#2d7a3a;" edge="1" parent="1" source="trainer" target="gloo"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- L3 → L2 -->
        <mxCell id="e_nixl_ucx" style="endArrow=block;html=1;strokeColor=#fb8c00;strokeWidth=2;" edge="1" parent="1" source="nixl" target="ucx"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_nccl_ofi" style="endArrow=block;html=1;strokeColor=#1f4f7a;strokeWidth=2;" edge="1" parent="1" source="nccl" target="awsofi"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- L2 → L1/L0 -->
        <mxCell id="e_ucx_efa" value="SRD" style="endArrow=block;html=1;strokeColor=#fb8c00;strokeWidth=2;fontSize=18;fontColor=#b3854a;" edge="1" parent="1" source="ucx" target="efako"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_ofi_lf" style="endArrow=block;html=1;strokeColor=#fb8c00;strokeWidth=2;" edge="1" parent="1" source="awsofi" target="libfabric"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_lf_efa" style="endArrow=block;html=1;strokeColor=#fb8c00;strokeWidth=2;" edge="1" parent="1" source="libfabric" target="efako"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_lf_gdr" value="GPU mem 転送時" style="endArrow=open;html=1;dashed=1;strokeColor=#f4a6b6;strokeWidth=2;fontSize=18;fontColor=#b3637a;" edge="1" parent="1" source="libfabric" target="gpudirect"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- L1 → L0 -->
        <mxCell id="e_efa_nic" style="endArrow=block;html=1;strokeColor=#e91e63;strokeWidth=2;" edge="1" parent="1" source="efako" target="efanic"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_gdr_gpu" style="endArrow=block;html=1;strokeColor=#e91e63;strokeWidth=2;" edge="1" parent="1" source="gpudirect" target="gpu"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- 凡例 -->
        <mxCell id="leg" value="凡例" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="1160" width="2580" height="120" as="geometry"/></mxCell>
        <mxCell id="legtxt" value="角丸の実線ボックス = slime が直接 / SGLang 経由で使う。六角形の破線グレー = slime は使わない (別環境用・参考)。&#10;weight sync (NCCL broadcast) と rollout データ収集 (Ray / NIXL) と gradient 同期 (NCCL) はいずれも aws-ofi-nccl / UCX 経由で EFA に到達する。GPU メモリ転送時は GPUDirect RDMA を併用。" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="80" y="1195" width="2540" height="80" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="rl-comm-flow" name="図2 RL通信フェーズ">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2700" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="図2: slime の GRPO 1 イテレーションのノード間通信フェーズ (AWS EFA 前提)" style="text;html=1;align=left;fontSize=26;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="1800" height="40" as="geometry"/></mxCell>
        <mxCell id="leg" value="赤 = ノード間 EFA を流れる通信 (gradient 同期・weight sync)。緑 = rollout 関連。灰 = ローカル / 制御のみ。&#10;weight sync (フェーズ 7) と gradient 同期 (フェーズ 6) は別系統: 前者は train→rollout の重み配布、後者は train 内 DP の勾配集約。" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="2580" height="70" as="geometry"/></mxCell>
        <mxCell id="trainbox" value="" style="rounded=1;fillColor=#eaf2fb;strokeColor=#4a78b5;" vertex="1" parent="1"><mxGeometry x="60" y="180" width="980" height="980" as="geometry"/></mxCell>
        <mxCell id="trainlab" value="Train cluster  (slime / Megatron: TP・PP・DP・EP)" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#1f4f7a;" vertex="1" parent="1"><mxGeometry x="80" y="190" width="900" height="30" as="geometry"/></mxCell>
        <mxCell id="rollbox" value="" style="rounded=1;fillColor=#eaf7ec;strokeColor=#4caf50;" vertex="1" parent="1"><mxGeometry x="1760" y="180" width="880" height="980" as="geometry"/></mxCell>
        <mxCell id="rolllab" value="Rollout cluster  (SGLang)" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#2d7a3a;" vertex="1" parent="1"><mxGeometry x="1780" y="190" width="840" height="30" as="geometry"/></mxCell>
        <mxCell id="efaband" value="" style="rounded=0;fillColor=#fff3e0;strokeColor=#fb8c00;" vertex="1" parent="1"><mxGeometry x="1080" y="180" width="640" height="980" as="geometry"/></mxCell>
        <mxCell id="efalab" value="ノード間ファブリック&#10;AWS EFA (SRD)" style="text;html=1;align=center;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#b3854a;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="1100" y="195" width="600" height="60" as="geometry"/></mxCell>
        <mxCell id="t_actor" value="Actor (学習中の重み)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a78b5;fontSize=20;" vertex="1" parent="1"><mxGeometry x="100" y="250" width="420" height="70" as="geometry"/></mxCell>
        <mxCell id="t_ref" value="Reference / Old policy&#10;(log-prob 計算)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a78b5;fontSize=20;" vertex="1" parent="1"><mxGeometry x="560" y="250" width="420" height="70" as="geometry"/></mxCell>
        <mxCell id="t_intra" value="" style="rounded=1;fillColor=#dbe8f7;strokeColor=#4a78b5;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="100" y="360" width="880" height="320" as="geometry"/></mxCell>
        <mxCell id="t_intralab" value="Train 内部分散通信 (フェーズ 6)" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontStyle=1;fontColor=#1f4f7a;" vertex="1" parent="1"><mxGeometry x="116" y="370" width="600" height="30" as="geometry"/></mxCell>
        <mxCell id="t_tp" value="TP AllReduce / AllGather&#10;(ノード内 NVLink)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a78b5;fontSize=20;" vertex="1" parent="1"><mxGeometry x="120" y="410" width="400" height="80" as="geometry"/></mxCell>
        <mxCell id="t_pp" value="PP P2P send/recv&#10;(activation・gradient)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a78b5;fontSize=20;" vertex="1" parent="1"><mxGeometry x="560" y="410" width="400" height="80" as="geometry"/></mxCell>
        <mxCell id="t_dp" value="DP gradient 同期&#10;NCCL AllReduce / reduce-scatter&#10;★ ノード間 EFA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde7ec;strokeColor=#e91e63;fontSize=20;" vertex="1" parent="1"><mxGeometry x="120" y="520" width="400" height="120" as="geometry"/></mxCell>
        <mxCell id="t_ep" value="MoE EP all-to-all&#10;(Megatron core)&#10;ノード跨ぎなら EFA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a78b5;fontSize=20;" vertex="1" parent="1"><mxGeometry x="560" y="520" width="400" height="120" as="geometry"/></mxCell>
        <mxCell id="t_rew" value="フェーズ 3-4: Reward (HTTP / ローカル)&#10;Advantage 正規化 (NCCL AllReduce, DP group)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=20;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="100" y="710" width="880" height="80" as="geometry"/></mxCell>
        <mxCell id="t_ws" value="フェーズ 7: Weight Sync 送信&#10;train actor の更新済み重みを rollout へ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde7ec;strokeColor=#e91e63;fontSize=20;fontStyle=1;fontColor=#b3214f;" vertex="1" parent="1"><mxGeometry x="100" y="830" width="880" height="90" as="geometry"/></mxCell>
        <mxCell id="r_engine" value="Rollout engine (SGLang 推論)&#10;sequences / tokens 生成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4caf50;fontSize=20;" vertex="1" parent="1"><mxGeometry x="1800" y="250" width="420" height="80" as="geometry"/></mxCell>
        <mxCell id="r_kv" value="フェーズ 1: KV cache は engine 内&#10;(TP 制御信号のみ, ノード内)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7ec;strokeColor=#4caf50;fontSize=20;fontColor=#2d7a3a;" vertex="1" parent="1"><mxGeometry x="1800" y="410" width="420" height="80" as="geometry"/></mxCell>
        <mxCell id="r_ws" value="フェーズ 7: Weight Sync 受信&#10;重みを engine に反映" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde7ec;strokeColor=#e91e63;fontSize=20;fontStyle=1;fontColor=#b3214f;" vertex="1" parent="1"><mxGeometry x="1800" y="830" width="420" height="90" as="geometry"/></mxCell>
        <mxCell id="p2" edge="1" parent="1" source="r_engine" target="t_ref" value="フェーズ 2: rollout データ収集&#10;sequences / old_log_prob&#10;Ray object store (既定) / NIXL+UCX (RDMA, 任意)" style="endArrow=block;html=1;strokeColor=#4caf50;strokeWidth=3;fontSize=20;fontColor=#2d7a3a;verticalAlign=top;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p7" edge="1" parent="1" source="t_ws" target="r_ws" value="フェーズ 7&#10;Weight Sync" style="endArrow=block;html=1;strokeColor=#e91e63;strokeWidth=4;fontSize=22;fontColor=#b3214f;fontStyle=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="wsbox" value="" style="rounded=1;fillColor=#fdf0f3;strokeColor=#e91e63;dashed=1;" vertex="1" parent="1"><mxGeometry x="60" y="1200" width="2580" height="260" as="geometry"/></mxCell>
        <mxCell id="wslab" value="slime の Weight Sync (フェーズ 7) の転送方式 — モデル規模・構成で選択" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#b3214f;" vertex="1" parent="1"><mxGeometry x="80" y="1210" width="1400" height="30" as="geometry"/></mxCell>
        <mxCell id="ws_colo" value="colocated (同一ノード)&#10;&#10;Ray IPC + Gloo gather&#10;ノード内, EFA 不使用&#10;UpdateWeightFromTensor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9e9e9e;fontSize=20;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="90" y="1255" width="780" height="190" as="geometry"/></mxCell>
        <mxCell id="ws_nccl" value="disaggregated: NCCL broadcast&#10;&#10;slime-pp_n group で EFA 経由&#10;UpdateWeightFromDistributed&#10;(aws-ofi-nccl → libfabric → EFA)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fb8c00;fontSize=20;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="920" y="1255" width="800" height="190" as="geometry"/></mxCell>
        <mxCell id="ws_delta" value="disaggregated: delta sync&#10;&#10;差分のみ NCCL broadcast / disk&#10;UpdateWeightFromDistributedDelta&#10;(disk は safetensors + 共有 FS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fb8c00;fontSize=20;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="1770" y="1255" width="800" height="190" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>