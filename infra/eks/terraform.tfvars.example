# Copy this file to terraform.tfvars and fill in the values.
# Do NOT commit terraform.tfvars — it may contain environment-specific values.

# AWS region. Must contain the AZ of your Capacity Block offering.
region = "us-east-2"

# Availability zones for the VPC and EKS control plane. EKS requires >= 2 AZs.
azs = ["us-east-2a", "us-east-2b"]

# EKS cluster name.
cluster_name = "distai-eks"

# Kubernetes version.
kubernetes_version = "1.35"

# --- Accelerator pools -------------------------------------------------------
# One map entry per accelerated NodePool. GPU (device_plugin="nvidia") and Trainium/
# Inferentia (device_plugin="neuron") are described uniformly; the matching device-plugin
# add-on and EFA layout are derived automatically. Each pool is pinned to a single AZ.
#
# capacity_type is per-pool, so on-demand / spot / reserved (Capacity Block) can be MIXED
# in one cluster — e.g. an on-demand GPU dev pool, a spot GPU experiment pool, and a
# reserved (CB) Trainium serving pool all at once. Karpenter provisions each independently.
accelerator_pools = {
  # GPU on-demand pool: g6e.12xlarge (L40S x4, single-card EFA). Steady dev/verification.
  gpu-training = {
    instance_type       = "g6e.12xlarge"
    device_plugin       = "nvidia"
    capacity_type       = "on-demand"
    zone                = "us-east-2b"
    efa_interface_count = 1
    efa_multi_card      = false
  }

  # GPU spot pool: cheapest, interruptible. Same shape as above but capacity_type = "spot".
  # Karpenter reclaims/replaces on spot interruption; good for stateless experiments.
  # gpu-spot = {
  #   instance_type       = "g6e.12xlarge"
  #   device_plugin       = "nvidia"
  #   capacity_type       = "spot"
  #   zone                = "us-east-2b"
  #   efa_interface_count = 1
  #   efa_multi_card      = false
  # }

  # GPU Capacity Block pool: p5en.48xlarge (H200 x8, EFA x16, multi-card).
  # gpu-p5en = {
  #   instance_type       = "p5en.48xlarge"
  #   device_plugin       = "nvidia"
  #   capacity_type       = "reserved"
  #   zone                = "us-east-2a"
  #   efa_interface_count = 16
  #   efa_multi_card      = true
  #   cb_reservation_id   = "cr-REPLACE_ME"
  #   volume_size         = "500Gi"
  # }

  # Trainium2 serving pool: trn2.48xlarge (16 Trainium2, EFA x16, multi-card).
  # trn2-serving = {
  #   instance_type       = "trn2.48xlarge"
  #   device_plugin       = "neuron"
  #   capacity_type       = "reserved"
  #   zone                = "us-east-2b"
  #   efa_interface_count = 16
  #   efa_multi_card      = true
  #   cb_reservation_id   = "cr-REPLACE_ME"
  #   ami_ssm_parameter   = "/aws/service/eks/optimized-ami/1.35/amazon-linux-2023/x86_64/neuron/recommended/image_id"
  #   volume_size         = "500Gi"
  # }
}

# Capacity Block expiry (RFC3339), used only for the pre-expiry SNS alert.
cb_end_date = "2024-12-31T23:59:59Z"

# Named AWS profile for Terraform provider authentication. The account ID is derived
# from these credentials automatically (no aws_account_id input needed).
aws_profile = "default"

# VPC CIDR. Use a /16 — accelerated ML nodes consume IPs heavily (VPC CNI secondary IPs +
# one IP per EFA-only ENI; trn2/p5en = 16 ENIs, p5 = 32). A /21 or /24 exhausts fast and the
# EKS control plane goes IMPAIRED (InsufficientFreeAddresses). Matches awsome-distributed-ai.
vpc_cidr = "10.0.0.0/16"

# Private subnets (one per AZ). Node workloads run here — make them huge (/18 = 16,384 IPs
# each). NOTE: leave headroom for the small public subnets carved from the TOP of the VPC.
# Do NOT size these /17 — two /17s consume the entire /16 and collide with the public /24s
# (InvalidSubnet.Conflict at apply). /18 x2 leaves 10.0.128.0/17 free for public + growth.
private_subnet_cidrs = ["10.0.0.0/18", "10.0.64.0/18"]

# Public subnets (one per AZ). NAT gateways + load balancers only — keep small (/24), carved
# from the top of the VPC so they do not eat into the private ranges.
public_subnet_cidrs = ["10.0.254.0/24", "10.0.255.0/24"]

# Deployment environment label (used in resource tags).
environment = "dev"

# --- GPU Operator ------------------------------------------------------------
# Install the NVIDIA driver via the operator? false = the AL2023 GPU AMI already ships it.
gpu_operator_install_driver = false
# Enable gdrcopy? Requires the gdrdrv kernel module; leave false unless the image builds it.
gpu_operator_enable_gdrcopy = false

# --- Neuron (Trainium/Inferentia) --------------------------------------------
# Enable the Neuron Scheduler Extension for multi-device tensor-parallel serving.
# neuron_enable_scheduler = true

# --- CPU NodePool ------------------------------------------------------------
cpu_nodepool_enabled    = true
cpu_instance_categories = ["c", "m", "r"]

# --- FSx for Lustre (PERSISTENT_2 SSD) ---------------------------------------
# Storage capacity must be a multiple of 2400 GiB.
fsx_per_unit_storage_throughput = 250
fsx_storage_capacity_gib        = 4800
# IRSA role ARN for aws-fsx-csi-driver; empty = use EKS Pod Identity / instance profile.
fsx_csi_driver_role_arn = ""

# Email addresses notified 1 hour before Capacity Block expiry. Empty = skip SNS.
cb_alert_email_addresses = []

# --- Component versions (override to upgrade) --------------------------------
karpenter_chart_version         = "1.13.0"
gpu_operator_chart_version      = "v25.10.1"
efa_device_plugin_chart_version = "v0.5.29"
mpi_operator_version            = "v0.6.0"
neuron_helm_chart_version       = "1.9.0"

# Common resource tags.
tags = {
  Project   = "distributed-ai"
  ManagedBy = "terraform"
}
