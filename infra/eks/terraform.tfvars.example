# Copy this file to terraform.tfvars and fill in the values.
# Do NOT commit terraform.tfvars — it may contain environment-specific values.
#
# For a basic cluster you only set two things: region and cluster_name. The AZ list and
# every subnet CIDR are DERIVED from region + vpc_cidr (see az.tf); accelerator pools are
# added later (Basic04+). Everything below region/cluster_name is optional — shown here with
# its default so you can see what is tunable, not because you must set it.

# AWS region. The VPC auto-spans EVERY standard AZ in it, so a Capacity Block landing in any
# AZ of this region always has a matching subnet.
region = "us-east-2"

# EKS cluster name.
cluster_name = "distai-eks"

# Availability zones. LEAVE UNSET (the default) to auto-derive every standard AZ in region —
# this is what makes the cluster resilient to a Capacity Block's AZ changing between
# reservations (you never edit this file when the CB moves). Uncomment to pin an explicit set
# (>= 2 AZs) only to exclude an AZ that lacks EKS/your instance type, or to fix the index
# order used by fsx_subnet_index / openzfs_subnet_index below.
# azs = ["us-east-2a", "us-east-2b"]

# Kubernetes version.
kubernetes_version = "1.35"

# --- Accelerator pools -------------------------------------------------------
# DO NOT define accelerator_pools in this file. The single map variable is assigned in
# exactly ONE place — the dedicated file `accelerator-pools.auto.tfvars` — so that this
# file plus a pool definition elsewhere never become a duplicate assignment (which
# Terraform rejects). To add pools, copy the dedicated template and edit the copy:
#
#     cp accelerator-pools.tfvars.example accelerator-pools.auto.tfvars
#
# Terraform auto-loads every `*.auto.tfvars`, and that file is git-ignored, so your real
# pool set / Capacity Block IDs stay out of version control. The variable has
# `default = {}`, so Basic01 (cluster scope only: VPC, control plane, system nodes,
# Karpenter, CSI, storage) applies fine even before that file exists — accelerator pools
# arrive from Basic04 onward. See accelerator-pools.tfvars.example for every pool shape
# (GPU on-demand / spot / Capacity Block, Trainium2) and the derivation rules.
# ─────────────────────────────────────────────────────────────────────────────────────────────

# Named AWS profile for Terraform provider authentication. The account ID is derived
# from these credentials automatically (no aws_account_id input needed).
#
# IF YOU AUTHENTICATE VIA A NAMED PROFILE (AWS SSO, Isengard/assume-role, or any
# named ~/.aws/config profile — this is the COMMON case), SET IT HERE and DO NOT
# leave it commented out. When set, Terraform passes --profile consistently to the
# aws/helm/kubectl providers AND the aws-CLI helpers (capacity-block describe,
# destroy-time drain), so every path authenticates as the SAME principal.
#
# Leave it commented out ONLY if your DEFAULT credential chain already resolves to
# the principal you want — i.e. static keys in [default], env vars, or an EC2/ECS
# instance role (e.g. CI runners). If your [default] profile is a DIFFERENT
# principal than the one you apply with (a classic trap: apply as an SSO/assume-role
# profile but [default] is a plain IAM user), the cluster grants admin only to the
# APPLYING principal, and a later `kubectl`/`update-kubeconfig` on [default] fails
# with "Unauthorized". See Basic01 for the matching `aws eks update-kubeconfig
# --profile ...` step.
# aws_profile = "my-profile"

# Guardrail: the 12-digit account you INTEND to deploy into. When set, Terraform fails the
# PLAN (before creating anything) if the resolved credentials point at a different account,
# so a profile mix-up can no longer silently re-create the cluster in the wrong account or
# duplicate-bill FSx filesystems. STRONGLY recommended to pin this for any real cluster.
# Find yours with: aws sts get-caller-identity --query Account --output text
# expected_account_id = "123456789012"

# VPC CIDR. Use a /16 — accelerated ML nodes consume IPs heavily via VPC CNI secondary IPs
# (prefix delegation reserves /28 = 16 IPs per slot). EFA-only interfaces do NOT consume IPs,
# but the CNI warm pool alone can exhaust a small subnet. Matches awslabs/awsome-distributed-ai.
vpc_cidr = "10.0.0.0/16"

# Subnet CIDRs are DERIVED from vpc_cidr and the resolved AZ list (az.tf): one large private
# subnet per AZ (the low half of the VPC, split evenly — e.g. /18 for 2 AZs, /19 for 4) and
# one small public /24 per AZ carved from the top. You do NOT set these. Uncomment to override
# with an explicit layout (must be one entry per resolved AZ, and private+public must not
# overlap). The commented values below reproduce the auto-derived 2-AZ layout for reference.
# private_subnet_cidrs = ["10.0.0.0/18", "10.0.64.0/18"]
# public_subnet_cidrs  = ["10.0.128.0/24", "10.0.129.0/24"]

# Deployment environment label (used in resource tags).
environment = "dev"

# --- GPU Operator ------------------------------------------------------------
# Install the NVIDIA driver via the operator? false = the AL2023 GPU AMI already ships it.
gpu_operator_install_driver = false
# Enable gdrcopy? Requires the gdrdrv kernel module; leave false unless the image builds it.
gpu_operator_enable_gdrcopy = false

# --- Neuron (Trainium/Inferentia) --------------------------------------------
# Enable the Neuron Scheduler Extension for multi-device tensor-parallel serving.
# neuron_enable_scheduler = true

# --- CPU NodePool ------------------------------------------------------------
cpu_nodepool_enabled    = true
cpu_instance_categories = ["c", "m", "r"]

# --- Shared storage ----------------------------------------------------------
# Default set = two single-AZ FSx layers (matches awsome-distributed-ai). Multi-AZ storage is
# a bad practice in this cluster: every accelerator pool is pinned to one AZ (EFA/RDMA is
# intra-AZ, Capacity Block is single-AZ), so a regional filesystem would be the anomaly.
# The CSI drivers for all three (Lustre/OpenZFS/EFS) are permanent infra installed regardless
# of these flags; the flags gate only the filesystems/PVs.
#
# FSx for Lustre: single-AZ high-throughput scratch/checkpoint. ON by default (nothing to
# write to otherwise). Capacity must be a multiple of 2400 GiB for PERSISTENT_2 SSD.
fsx_enabled                     = true
fsx_per_unit_storage_throughput = 250
fsx_storage_capacity_gib        = 4800
# Index into the resolved AZ list (local.azs) picking which AZ this filesystem lives in.
# 0 = the first cluster AZ, which is also where on-demand/spot pools default — so the default
# keeps compute and storage co-located. Must be < the number of resolved AZs.
fsx_subnet_index = 0
#
# FSx for OpenZFS: single-AZ NFS home/general-shared layer (many small files). ON by default.
# throughput valid values for SINGLE_AZ_1 (non-HA): 64/128/256/512/1024/2048/3072/4096 MB/s.
openzfs_enabled              = true
openzfs_storage_capacity_gib = 256
openzfs_throughput_capacity  = 256
openzfs_subnet_index         = 0
#
# EFS: DEMOTED to opt-in. Regional multi-AZ RWX; enable only for the one workload that needs a
# cache surviving a cross-AZ Karpenter reschedule (voice-image-edit NEFF/HF cache). OFF here.
efs_enabled = false

# Email addresses notified 1 hour before a Capacity Block expires (per-pool cb_end_date).
# Empty = skip SNS subscriptions.
cb_alert_email_addresses = []

# --- Public ingress demo (opt-in) ---------------------------------------------
# Off by default: a base cluster should never stand up a public, unauthenticated ALB.
# enable_demo_app = true    # Phase 1: ALB Controller + demo echo app behind a plain ALB.
# enable_cloudfront = true  # Phase 2 (requires enable_demo_app): CloudFront + SG lock-down.
#                            # Apply Phase 1 first and wait for the ALB to exist before Phase 2.

# --- Component versions (override to upgrade) --------------------------------
karpenter_chart_version         = "1.13.0"
gpu_operator_chart_version      = "v25.10.1"
efa_device_plugin_chart_version = "v0.5.29"
neuron_helm_chart_version       = "1.9.0"
# Only used when enable_demo_app = true. alb_controller_app_version is a separate
# variable from the chart version because the two are independent release series.
alb_controller_chart_version = "3.4.1"
alb_controller_app_version   = "3.4.1"

# Common resource tags.
tags = {
  Project   = "distributed-ai"
  ManagedBy = "terraform"
}
