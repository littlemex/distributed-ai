# The shape of a producer Job: run any workload under a profiler and record it, without the
# workload's image carrying anything.
#
# This is a plain manifest with @PLACEHOLDER@ markers rather than a Helm template, so the shape stays
# reviewable on its own and the client that fills it needs nothing but kubectl. Every placeholder is
# substituted by scripts/kubectl-profile, never by a person, so an unset value is a bug in the client
# rather than a silently empty field. Render a copy for GitOps with `kubectl-profile run --dry-run`.
#
# Three parts, and the reason for each:
#   tools (init)  copies the shim, and the profiler when it is being injected, out of the platform
#                 image into a shared volume — an ordinary training image then needs no rebuild.
#   workload      the caller's own image and command, wrapped by the shim, which captures the profile
#                 and writes a status file on every exit path it can observe.
#   recorder      the platform image, which waits for that status, reads the file contract and logs
#                 one MLflow run. Recording lives here because the accelprof package pins compiled
#                 dependencies to one Python version, so it cannot be injected into an arbitrary image.
#
# The Job is left to Kubernetes to clean up (ttlSecondsAfterFinished) instead of to the client: a
# client that creates and deletes cannot keep its promise when it is interrupted.
apiVersion: batch/v1
kind: Job
metadata:
  name: "@JOB_NAME@"
  namespace: "@NAMESPACE@"
  labels:
    app.kubernetes.io/name: profiling-producer
    accelprof.io/alias: "@ALIAS@"
    accelprof.io/workload-id: "@WORKLOAD_ID@"
spec:
  backoffLimit: 0
  ttlSecondsAfterFinished: @TTL_SECONDS@
  template:
    metadata:
      labels:
        app.kubernetes.io/name: profiling-producer
        accelprof.io/alias: "@ALIAS@"
        accelprof.io/workload-id: "@WORKLOAD_ID@"
    spec:
      restartPolicy: Never
      serviceAccountName: "@SERVICE_ACCOUNT@"
      volumes:
        - name: accelprof
          emptyDir: {}
      initContainers:
        - name: tools
          image: "@PLATFORM_IMAGE@"
          command: ["sh", "-c", "@TOOLS_SCRIPT@"]
          volumeMounts:
            - { name: accelprof, mountPath: /accelprof }
          resources:
            requests: { cpu: "250m", memory: "256Mi" }
      containers:
        - name: workload
          image: "@WORKLOAD_IMAGE@"
          command: ["/accelprof/tools/entry.sh"]
          args: @COMMAND_JSON@
          env:
            - { name: ACCELPROF_OUT, value: "/accelprof/out" }
            - { name: ACCELPROF_TOOLS, value: "/accelprof/tools" }
            - { name: ACCELPROF_PROFILE_MODE, value: "@PROFILE_MODE@" }
            - { name: ACCELPROF_PROFILE_RANKS, value: "@PROFILE_RANKS@" }
            - { name: ACCELPROF_NSYS_ARGS, value: "@NSYS_ARGS@" }
            - name: ACCELPROF_POD_NAME
              valueFrom: { fieldRef: { fieldPath: metadata.name } }
          volumeMounts:
            - { name: accelprof, mountPath: /accelprof }
        - name: recorder
          image: "@PLATFORM_IMAGE@"
          command: ["python3", "/opt/accelprof/recorder.py"]
          env:
            - { name: ACCELPROF_OUT, value: "/accelprof/out" }
            - { name: ACCELPROF_ALIAS, value: "@ALIAS@" }
            - { name: ACCELPROF_CHIP, value: "@CHIP@" }
            - { name: ACCELPROF_WORKLOAD_ID, value: "@WORKLOAD_ID@" }
            - { name: ACCELPROF_JOB_NAME, value: "@JOB_NAME@" }
            - { name: ACCELPROF_PROFILE_MODE, value: "@PROFILE_MODE@" }
            - { name: ACCELPROF_PROFILE_RANKS, value: "@PROFILE_RANKS@" }
            - { name: ACCELPROF_RECORD_ON_FAILURE, value: "@RECORD_ON_FAILURE@" }
            - { name: ACCELPROF_RECORDER_TIMEOUT, value: "@RECORDER_TIMEOUT@" }
            - name: ACCELPROF_POD_NAME
              valueFrom: { fieldRef: { fieldPath: metadata.name } }
            - name: ACCELPROF_POD_NAMESPACE
              valueFrom: { fieldRef: { fieldPath: metadata.namespace } }
          envFrom:
            # region, trace bucket and tracking server, published into this namespace by the installer
            - configMapRef:
                name: accelprof-config
          volumeMounts:
            - { name: accelprof, mountPath: /accelprof }
          resources:
            requests: { cpu: "100m", memory: "256Mi" }
            limits: { memory: "1Gi" }
