# Kueue reference example: one ClusterQueue over one existing NodePool, one LocalQueue in the
# namespace that opts in. Copy this file, substitute the two placeholders, and `kubectl apply -f`.
# This is deliberately NOT applied by `terraform apply` — it is as workload-shape-specific as
# accelerator-pools.auto.tfvars, and belongs with the workshop step that uses it, not with the
# always-on controller install in kueue.tf.
#
# Placeholders:
#   __NAMESPACE__      the namespace this queue serves (must carry managed-by-kueue=true, see below)
#   __NODEPOOL_NAME__  the Karpenter NodePool this ResourceFlavor targets (e.g. gpu-ddp)
#   __GPU_QUOTA__      how many nvidia.com/gpu this ClusterQueue may admit at once, in total across
#                      every LocalQueue in its cohort. Set this to what the NodePool can actually
#                      give you right now, not to how many GPUs you wish it had: Kueue's admission
#                      has no idea whether the NodePool's instance types, AZ, or Spot availability
#                      can back this number. A quota Karpenter cannot fill behaves exactly like an
#                      ordinary unschedulable-pod wait -- Workloads admit, their Pods stay Pending,
#                      and nothing in Kueue itself will tell you why (check NodeClaims/Karpenter's
#                      own logs the same way Basic04's troubleshooting section does).

apiVersion: v1
kind: Namespace
metadata:
  name: __NAMESPACE__
  labels:
    # The opt-in label kueue.tf's managerConfig.managedJobsNamespaceSelector requires. Without
    # this label, Kueue's webhooks never look at anything in this namespace, the queue-name label
    # on a TrainJob/RayJob is simply inert, and the Workload it should have produced is never
    # created -- which looks identical to "the queue is stuck" from the workload side. Check this
    # label first if an admitted-looking job never gets a Workload object.
    managed-by-kueue: "true"
---
apiVersion: kueue.x-k8s.io/v1beta2
kind: ResourceFlavor
metadata:
  name: __NODEPOOL_NAME__
spec:
  # Matches nodes Karpenter launched from this NodePool. karpenter.sh/nodepool is a label
  # Karpenter sets on every node it manages, not something this NodePool's definition has to
  # request -- any NodePool name works here as-is.
  nodeLabels:
    karpenter.sh/nodepool: __NODEPOOL_NAME__
---
apiVersion: kueue.x-k8s.io/v1beta2
kind: ClusterQueue
metadata:
  name: __NODEPOOL_NAME__-cq
spec:
  namespaceSelector: {}   # which namespaces may attach a LocalQueue to this ClusterQueue; {} = any
  resourceGroups:
    - coveredResources: ["cpu", "memory", "nvidia.com/gpu"]
      flavors:
        - name: __NODEPOOL_NAME__
          resources:
            - name: "cpu"
              nominalQuota: "32"
            - name: "memory"
              nominalQuota: "128Gi"
            - name: "nvidia.com/gpu"
              nominalQuota: "__GPU_QUOTA__"
---
apiVersion: kueue.x-k8s.io/v1beta2
kind: LocalQueue
metadata:
  name: __NODEPOOL_NAME__
  namespace: __NAMESPACE__
spec:
  clusterQueue: __NODEPOOL_NAME__-cq
